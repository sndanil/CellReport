<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net5.0;net48</TargetFrameworks>
    <AssemblyVersion>0.11.2504.1710</AssemblyVersion>
    <FileVersion>0.11.2504.1710</FileVersion>
    <Copyright>Copyright © Daniil Safonov 2011-2021</Copyright>
    <Company>Daniil Safonov</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="mustache-sharp" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' != 'net45' ">
    <PackageReference Include="System.IO.Packaging" Version="9.0.1" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="$(SolutionDir)buildnumerator.exe $(ProjectDir) $(ConfigurationName)" />
  </Target>

</Project>
