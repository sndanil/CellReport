<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:CellReport.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CellReport.Avalonia.PresentControl">
	<UserControl.Resources>
		<SolidColorBrush x:Key="ResizersBackBrush" Color="#DFE3E8" />
		<SolidColorBrush x:Key="ResizersTextBrush" Color="#363636" />
		<SolidColorBrush x:Key="ResizersLineBrush" Color="#B1B5BA" />
		<FontFamily x:Key="ResizersFont">Microsoft Sans Serif</FontFamily>
	</UserControl.Resources>
	
	<Grid ColumnDefinitions="auto *" RowDefinitions="auto *" Background="{DynamicResource ResizersBackBrush}">
		<local:ColumnResizerControl Grid.Column="1" Height="25" Name="columnsResizer" />
		<local:RowResizerControl Grid.Row="1" Width="25" Name="rowsResizer" />
		<local:CellControl Grid.Row="1" Grid.Column="1" Name="cellControl" />
	</Grid>
</UserControl>
