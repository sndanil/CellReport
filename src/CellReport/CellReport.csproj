<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<LangVersion>7.3</LangVersion>
		<AssemblyVersion>0.12.1</AssemblyVersion>
		<FileVersion>0.12.1</FileVersion>
		<Copyright>Copyright © Daniil Safonov 2011-2025</Copyright>
		<Company>Daniil Safonov</Company>

		<PackageId>KCellReport</PackageId>
		<IsPackable>true</IsPackable>
		<Description>Ядро CellReport: шаблоны, ReportDocument, экспорт, Skia-рендерер</Description>
		<PackageTags>reporting;excel;pdf;html;skia;barcode;net48;net8</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="mustache-sharp" Version="1.0.0" />
		<PackageReference Include="Nut" Version="4.0.0" />
		<PackageReference Include="SkiaSharp" Version="3.116.1" />
		<PackageReference Include="Topten.RichTextKit" Version="0.4.167" />
		<PackageReference Include="ZXing.Net" Version="0.16.10" />
		<PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.21" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Packaging" Version="9.0.1" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
		<Reference Include="System.Net.Http">
			<HintPath>{GAC}</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
