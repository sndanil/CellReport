<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CellReport.Avalonia"
             xmlns:vm="clr-namespace:CellReport.Avalonia.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CellReport.Avalonia.PresentControl"
             x:DataType="vm:PresentControlViewModel">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://CellReport.Avalonia/Themes/CellReportTheme.axaml" />
			</ResourceDictionary.MergedDictionaries>
			<FontFamily x:Key="ResizersFont">Microsoft Sans Serif</FontFamily>
		</ResourceDictionary>
	</UserControl.Resources>

	<UserControl.Styles>
		<StyleInclude Source="avares://CellReport.Avalonia/Themes/CellReportControls.axaml" />
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<Border Grid.Row="0"
		        Classes="toolbar"
		        IsVisible="{Binding ShowToolBar}">
			<StackPanel Classes="toolbar-items">
				<SplitButton Classes="toolbar-button toolbar-icon-button"
				             Name="printSplitButton"
				             Click="PrintSplitButton_Click"
				             ToolTip.Tip="{Binding PrintLabel}">
					<materialIcons:MaterialIcon Kind="Printer" Classes="toolbar-icon icon-muted" />
					<SplitButton.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedLeft" />
					</SplitButton.Flyout>
				</SplitButton>

				<Border Classes="toolbar-separator" />

				<ToggleButton Classes="toolbar-button toolbar-icon-button"
				              IsChecked="{Binding ShowGridLines}"
				              ToolTip.Tip="{Binding ShowGridLabel}">
					<materialIcons:MaterialIcon Kind="Grid" Classes="toolbar-icon icon-muted" />
				</ToggleButton>
				<ToggleButton Classes="toolbar-button toolbar-icon-button"
				              IsChecked="{Binding ShowResizers}"
				              ToolTip.Tip="{Binding ShowResizersLabel}">
					<materialIcons:MaterialIcon Kind="TableHeadersEye" Classes="toolbar-icon icon-muted" />
				</ToggleButton>

				<Border Classes="toolbar-separator" />

				<ComboBox Width="80"
				          Margin="4,0"
				          VerticalAlignment="Center"
				          ItemsSource="{Binding ScaleOptions}"
				          SelectedIndex="{Binding SelectedScaleIndex}" />

				<Border Classes="toolbar-separator" />

				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding ExportExcelCommand}"
				        ToolTip.Tip="{Binding ExportExcelLabel}">
					<materialIcons:MaterialIcon Kind="FileExcelBox" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding ExportHtmlCommand}"
				        ToolTip.Tip="{Binding ExportHtmlLabel}">
					<materialIcons:MaterialIcon Kind="LanguageHtml5" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding ExportPdfCommand}"
				        ToolTip.Tip="{Binding ExportPdfLabel}">
					<materialIcons:MaterialIcon Kind="FilePdfBox" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding SaveCommand}"
				        ToolTip.Tip="{Binding SaveLabel}">
					<materialIcons:MaterialIcon Kind="ContentSave" Classes="toolbar-icon icon-muted" />
				</Button>

				<Border Classes="toolbar-separator" />

				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding FindCommand}"
				        ToolTip.Tip="{Binding FindLabel}">
					<materialIcons:MaterialIcon Kind="Magnify" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button"
				        Command="{Binding GoToRowCommand}"
				        ToolTip.Tip="{Binding GoToRowLabel}">
					<materialIcons:MaterialIcon Kind="FormatListNumbered" Classes="toolbar-icon icon-muted" />
				</Button>

				<Border Classes="toolbar-separator" />

				<ToggleButton Classes="toolbar-button toolbar-icon-button"
				              IsChecked="{Binding ShowBookMarks}"
				              ToolTip.Tip="{Binding BookMarksLabel}">
					<materialIcons:MaterialIcon Kind="BookmarkOutline" Classes="toolbar-icon icon-muted" />
				</ToggleButton>
			</StackPanel>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*">
			<TreeView Grid.Column="0"
			          Name="bookMarksTree"
			          Width="220"
			          Margin="0,0,4,0"
			          IsVisible="{Binding ShowBookMarks}"
			          ItemsSource="{Binding BookMarks}"
			          SelectedItem="{Binding SelectedBookMark}">
				<TreeView.ItemTemplate>
					<TreeDataTemplate DataType="vm:BookMarkItemViewModel" ItemsSource="{Binding Children}">
						<TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
					</TreeDataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>

			<Grid Grid.Column="1"
			      ColumnDefinitions="Auto,*,Auto"
			      RowDefinitions="Auto,*,Auto"
			      Background="{DynamicResource CellReport.Grid.HeaderBackground}">
				<Border Grid.Row="0"
				        Grid.Column="0"
				        Width="30"
				        Height="20"
				        IsVisible="{Binding ShowResizers}"
				        Background="{DynamicResource CellReport.Grid.HeaderBackground}"
				        BorderBrush="{DynamicResource CellReport.Grid.HeaderBorder}"
				        BorderThickness="0,0,1,1" />
				<local:ColumnResizerControl Grid.Column="1"
				                            Grid.Row="0"
				                            Height="20"
				                            Name="columnsResizer" />
				<local:RowResizerControl Grid.Column="0"
				                         Grid.Row="1"
				                         Width="30"
				                         Name="rowsResizer" />
				<local:CellControl Grid.Column="1"
				                   Grid.Row="1"
								   Grid.ColumnSpan="2"
								   Grid.RowSpan="2"
				                   Name="cellControl">
					<local:CellControl.ContextMenu>
						<ContextMenu x:DataType="vm:PresentControlViewModel">
							<MenuItem Header="{Binding PrintLabel}" Command="{Binding PrintCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="Printer" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding CustomPrintLabel}" Command="{Binding CustomPrintCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="PrinterSettings" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding PreviewLabel}" Command="{Binding PrintPreviewCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="FileEyeOutline" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding PageSetupLabel}" Command="{Binding PageSetupCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="FileSettingsOutline" />
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<MenuItem Header="{Binding ShowGridLabel}"
							          ToggleType="CheckBox"
							          IsChecked="{Binding ShowGridLines}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="Grid" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding ShowResizersLabel}"
							          ToggleType="CheckBox"
							          IsChecked="{Binding ShowResizers}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="TableHeadersEye" />
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<MenuItem Header="{Binding GoToRowLabel}"
							          Command="{Binding GoToRowCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="FormatListNumbered" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding FindLabel}"
							          Command="{Binding FindCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="Magnify" />
								</MenuItem.Icon>
							</MenuItem>
							<Separator />
							<MenuItem Header="{Binding ExportExcelLabel}"
							          Command="{Binding ExportExcelCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="FileExcelBox" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding ExportHtmlLabel}"
							          Command="{Binding ExportHtmlCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="LanguageHtml5" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding ExportPdfLabel}"
							          Command="{Binding ExportPdfCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="FilePdfBox" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding ExportImageLabel}"
							          Command="{Binding ExportImageCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="Image" />
								</MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="{Binding SaveLabel}"
							          Command="{Binding SaveCommand}">
								<MenuItem.Icon>
									<materialIcons:MaterialIcon Kind="ContentSave" />
								</MenuItem.Icon>
							</MenuItem>
						</ContextMenu>
					</local:CellControl.ContextMenu>
				</local:CellControl>
				<ScrollBar Grid.Column="2"
				           Grid.Row="1"
				           Name="vScrollBar"
				           Orientation="Vertical"
				           SmallChange="1"
				           LargeChange="5" />
				<ScrollBar Grid.Column="1"
				           Grid.Row="2"
				           Name="hScrollBar"
				           Orientation="Horizontal"
				           SmallChange="1"
				           LargeChange="5" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>