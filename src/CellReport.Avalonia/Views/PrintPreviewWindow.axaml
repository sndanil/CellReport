<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CellReport.Avalonia.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CellReport.Avalonia.Views.PrintPreviewWindow"
        x:DataType="vm:PrintPreviewViewModel"
        Title="{Binding Title}"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://CellReport.Avalonia/Themes/CellReportTheme.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Window.Styles>
		<StyleInclude Source="avares://CellReport.Avalonia/Themes/CellReportControls.axaml" />
	</Window.Styles>
	<Grid RowDefinitions="Auto,Auto,*">
		<Border Grid.Row="0" Classes="toolbar">
			<StackPanel Classes="toolbar-items">
				<Button Classes="toolbar-button" Command="{Binding PrintCommand}" ToolTip.Tip="{Binding PrintLabel}">
					<StackPanel Classes="toolbar-content">
						<materialIcons:MaterialIcon Kind="Printer" Classes="toolbar-icon icon-muted" />
						<TextBlock Text="{Binding PrintLabel}" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
				<Button Classes="toolbar-button" Command="{Binding PageSetupCommand}" ToolTip.Tip="{Binding PageSetupLabel}">
					<StackPanel Classes="toolbar-content">
						<materialIcons:MaterialIcon Kind="FileSettingsOutline" Classes="toolbar-icon icon-muted" />
						<TextBlock Text="{Binding PageSetupLabel}" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
				<ToggleButton Classes="toolbar-button toolbar-icon-button" IsChecked="{Binding AutoFitWidth}" ToolTip.Tip="{Binding AutoFitLabel}">
					<materialIcons:MaterialIcon Kind="FitToPageOutline" Classes="toolbar-icon icon-muted" />
				</ToggleButton>

				<Border Classes="toolbar-separator" />

				<Button Classes="toolbar-button toolbar-icon-button" Command="{Binding FirstPageCommand}" ToolTip.Tip="Первая страница">
					<materialIcons:MaterialIcon Kind="SkipPrevious" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" ToolTip.Tip="Предыдущая">
					<materialIcons:MaterialIcon Kind="ChevronLeft" Classes="toolbar-icon icon-muted" />
				</Button>
				<TextBlock VerticalAlignment="Center" Margin="4,0">
					<Run Text="{Binding CurrentPage}" />
					<Run Text="/" />
					<Run Text="{Binding TotalPages}" />
				</TextBlock>
				<Button Classes="toolbar-button toolbar-icon-button" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" ToolTip.Tip="Следующая">
					<materialIcons:MaterialIcon Kind="ChevronRight" Classes="toolbar-icon icon-muted" />
				</Button>
				<Button Classes="toolbar-button toolbar-icon-button" Command="{Binding LastPageCommand}" ToolTip.Tip="Последняя страница">
					<materialIcons:MaterialIcon Kind="SkipNext" Classes="toolbar-icon icon-muted" />
				</Button>

				<Border Classes="toolbar-separator" />

				<ComboBox Width="90"
				          Margin="4,0"
				          VerticalAlignment="Center"
				          ItemsSource="{Binding ZoomOptions}"
				          SelectedIndex="{Binding SelectedZoomIndex}" />
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Classes="toolbar">
			<StackPanel Classes="toolbar-items">
				<TextBlock Text="{Binding PrinterLabel}" VerticalAlignment="Center" Margin="8,0,4,0" />
				<ComboBox Width="280"
				          Margin="0,2"
				          VerticalAlignment="Center"
				          ItemsSource="{Binding Printers}"
				          SelectedItem="{Binding SelectedPrinter}" />
				<TextBlock Text="{Binding PaperDescription}"
				           VerticalAlignment="Center"
				           Margin="12,0,8,0"
				           Foreground="{DynamicResource CellReport.Icon.Muted}" />
			</StackPanel>
		</Border>

		<ScrollViewer x:Name="PreviewViewer"
		              Grid.Row="2"
		              HorizontalScrollBarVisibility="Auto"
		              VerticalScrollBarVisibility="Auto"
		              Background="{DynamicResource CellReport.Content.Background}">
			<LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
				<LayoutTransformControl.LayoutTransform>
					<ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
				</LayoutTransformControl.LayoutTransform>
				<Image Source="{Binding PageImage}"
				       Stretch="None"
				       Margin="8" />
			</LayoutTransformControl>
		</ScrollViewer>
	</Grid>
</Window>