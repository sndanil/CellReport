<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CellReport.Avalonia.ViewModels"
        x:Class="CellReport.Avalonia.Views.PageSetupDialog"
        x:DataType="vm:PageSetupDialogViewModel"
        Title="{Binding Title}"
		SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
	<Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
		<TextBlock Grid.Row="0" Text="{Binding MarginsLabel}" FontWeight="SemiBold" />

		<Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LeftLabel}" VerticalAlignment="Center" />
			<NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarginLeft}" FormatString="0.0" />

			<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding RightLabel}" VerticalAlignment="Center" />
			<NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarginRight}" FormatString="0.0" />

			<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding TopLabel}" VerticalAlignment="Center" />
			<NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarginTop}" FormatString="0.0" />

			<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BottomLabel}" VerticalAlignment="Center" />
			<NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MarginBottom}" FormatString="0.0" />

			<CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="{Binding LandscapeLabel}" IsChecked="{Binding Landscape}" />

			<TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding CopiesLabel}" VerticalAlignment="Center" />
			<NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="99" Value="{Binding Copies}" FormatString="0" />
		</Grid>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="{Binding OkLabel}" Click="OnOkClick" IsDefault="True" />
			<Button Content="{Binding CancelLabel}" Click="OnCancelClick" IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
