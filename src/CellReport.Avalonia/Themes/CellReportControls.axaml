<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

	<!--
		CellReport.Avalonia control styles. Mirrors Kayala.UI.Avalonia/Themes/AppControls.axaml
		so the report toolbar, icons and dialogs match Kayala apps in light and dark themes.
		Theme brushes come from CellReportTheme.axaml (CellReport.* keys).
	-->

	<!-- WinForms dialog baseline ≈ 8.25–8.5pt (~11–11.5 DIP). -->
	<Style Selector="Window">
		<Setter Property="FontFamily" Value="Segoe UI, Microsoft Sans Serif" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="TextBlock">
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="TextBox">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="ComboBox">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="NumericUpDown">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="Padding" Value="6 0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
		<Setter Property="MinHeight" Value="24" />
	</Style>

	<Style Selector="CalendarDatePicker">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>

	<Style Selector="TimePicker">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="24" />
	</Style>

	<Style Selector="CheckBox">
		<Setter Property="FontSize" Value="12" />
	</Style>
	<!-- Disabled checkboxes must stay readable on dark theme (Avalonia default is nearly invisible). -->
	<Style Selector="CheckBox:disabled">
		<Setter Property="Foreground" Value="{DynamicResource CellReport.Grid.HeaderForeground}" />
		<Setter Property="Opacity" Value="0.75" />
	</Style>

	<Style Selector="TabControl">
		<Setter Property="FontSize" Value="12" />
	</Style>

	<!-- Must use /template/ — otherwise ComboBox dropdown ItemsPresenter inside a TabItem
	     also matches and gets Height=24 (one item), looking like a z-index/clip bug. -->
	<Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
		<Setter Property="Height" Value="24" />
	</Style>

	<Style Selector="TabItem">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="30" />
	</Style>

	<Style Selector="Button">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="SplitButton">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<!-- ===== Dialog chrome ===== -->

	<Style Selector="DockPanel.dialog-body">
		<Setter Property="Margin" Value="12" />
	</Style>

	<Style Selector="DockPanel.dialog-body.comfortable">
		<Setter Property="Margin" Value="16" />
	</Style>

	<Style Selector="StackPanel.dialog-buttons">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="Spacing" Value="10" />
		<Setter Property="Margin" Value="0,12,0,0" />
	</Style>

	<Style Selector="Button.dialog-button">
		<Setter Property="Width" Value="100" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="100" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.dialog-button /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<!-- ===== Text helpers ===== -->

	<Style Selector="TextBlock.muted">
		<Setter Property="Opacity" Value="0.75" />
	</Style>

	<Style Selector="TextBlock.muted-soft">
		<Setter Property="Opacity" Value="0.65" />
	</Style>

	<Style Selector="TextBlock.muted-strong">
		<Setter Property="Opacity" Value="0.85" />
	</Style>

	<Style Selector="TextBlock.title">
		<Setter Property="FontSize" Value="22" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- ===== Toolbar (WinForms ToolStrip look) ===== -->

	<Style Selector="Border.toolbar">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Background}" />
		<Setter Property="BorderBrush" Value="{DynamicResource CellReport.Toolbar.Border}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
		<Setter Property="Padding" Value="4,2" />
	</Style>

	<Style Selector="StackPanel.toolbar-items">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Spacing" Value="0" />
	</Style>

	<Style Selector="Border.toolbar-separator">
		<Setter Property="Width" Value="1" />
		<Setter Property="Margin" Value="6,6" />
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Separator}" />
	</Style>

	<Style Selector="StackPanel.toolbar-content">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Spacing" Value="6" />
	</Style>

	<Style Selector="StackPanel.toolbar-content > TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.toolbar-button, SplitButton.toolbar-button, ToggleButton.toolbar-button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="6,2" />
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.toolbar-button /template/ ContentPresenter, SplitButton.toolbar-button /template/ ContentPresenter, ToggleButton.toolbar-button /template/ ContentPresenter">
		<Setter Property="RecognizesAccessKey" Value="False" />
	</Style>

	<Style Selector="Button.toolbar-button.toolbar-icon-button, SplitButton.toolbar-button.toolbar-icon-button, ToggleButton.toolbar-button.toolbar-icon-button">
		<Setter Property="Padding" Value="10,4" />
	</Style>

	<Style Selector="Button.toolbar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Hover}" />
	</Style>

	<Style Selector="Button.toolbar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Pressed}" />
	</Style>

	<Style Selector="Button.toolbar-button:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>

	<Style Selector="ToggleButton.toolbar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Hover}" />
	</Style>

	<Style Selector="ToggleButton.toolbar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Pressed}" />
	</Style>

	<Style Selector="ToggleButton.toolbar-button:checked /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Pressed}" />
	</Style>

	<Style Selector="ToggleButton.toolbar-button:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Hover}" />
	</Style>

	<Style Selector="ToggleButton.toolbar-button:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>

	<Style Selector="SplitButton.toolbar-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Hover}" />
	</Style>

	<Style Selector="SplitButton.toolbar-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource CellReport.Toolbar.Pressed}" />
	</Style>

	<Style Selector="SplitButton.toolbar-button:disabled">
		<Setter Property="Opacity" Value="0.45" />
	</Style>

	<!-- ===== Toolbar icons ===== -->

	<Style Selector="icons|MaterialIcon.toolbar-icon">
		<Setter Property="Width" Value="18" />
		<Setter Property="Height" Value="18" />
	</Style>

	<Style Selector="icons|MaterialIcon.icon-success">
		<Setter Property="Foreground" Value="{DynamicResource CellReport.Icon.Success}" />
	</Style>

	<Style Selector="icons|MaterialIcon.icon-danger">
		<Setter Property="Foreground" Value="{DynamicResource CellReport.Icon.Danger}" />
	</Style>

	<Style Selector="icons|MaterialIcon.icon-muted">
		<Setter Property="Foreground" Value="{DynamicResource CellReport.Icon.Muted}" />
	</Style>

	<Style Selector="icons|MaterialIcon.icon-accent">
		<Setter Property="Foreground" Value="{DynamicResource CellReport.Icon.Accent}" />
	</Style>

</Styles>