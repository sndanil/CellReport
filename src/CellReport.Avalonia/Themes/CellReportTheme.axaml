<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Light/Dark theme brushes for CellReport.Avalonia controls.
		Palette mirrors Kayala.UI.Avalonia/Themes/KayalaTheme.axaml so the report
		controls (toolbar, icons, resizers, cells) match Kayala apps in both themes.
		When hosted inside a Kayala app, CellReport controls render with the same
		palette regardless of which dictionary is in scope.
	-->
	<ResourceDictionary.ThemeDictionaries>
		<!-- Light -->
		<ResourceDictionary x:Key="Light">
			<!-- Toolbar / icons -->
			<SolidColorBrush x:Key="CellReport.Toolbar.Background" Color="#F5F5F5" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Border" Color="#D0D0D0" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Separator" Color="#C0C0C0" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Hover" Color="#E8E8E8" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Pressed" Color="#D0D0D0" />
			<SolidColorBrush x:Key="CellReport.Icon.Success" Color="#2E7D32" />
			<SolidColorBrush x:Key="CellReport.Icon.Danger" Color="#C62828" />
			<SolidColorBrush x:Key="CellReport.Icon.Muted" Color="#616161" />
			<SolidColorBrush x:Key="CellReport.Icon.Accent" Color="#1565C0" />
			<SolidColorBrush x:Key="CellReport.Error.Foreground" Color="#C62828" />
			<SolidColorBrush x:Key="CellReport.Content.Background" Color="#FFFFFF" />

			<!-- Grid / headers / resizers -->
			<SolidColorBrush x:Key="CellReport.Grid.Background" Color="#FFFFFF" />
			<SolidColorBrush x:Key="CellReport.Grid.Foreground" Color="#000000" />
			<SolidColorBrush x:Key="CellReport.Grid.Border" Color="#6B6B6B" />
			<SolidColorBrush x:Key="CellReport.Grid.Line" Color="#DADCDD" />
			<SolidColorBrush x:Key="CellReport.Grid.AlternatingRow" Color="#64DFE3E8" />
			<SolidColorBrush x:Key="CellReport.Grid.RowHover" Color="#28DFE3E8" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedRow" Color="#AFD2F6" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellFocused" Color="#FFDC61" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellUnfocused" Color="#DCE8F4" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellForeground" Color="#1A1A1A" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderBackground" Color="#DFE3E8" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderForeground" Color="#363636" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderBorder" Color="#B1B5BA" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderHover" Color="#D5DAE0" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderSeparator" Color="#9EB6CE" />
			<SolidColorBrush x:Key="CellReport.Grid.SortableHeader" Color="#0000FF" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedHeaderForeground" Color="#1A1A1A" />
			<LinearGradientBrush x:Key="CellReport.Grid.SelectedHeader" StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#FFD359" Offset="0" />
				<GradientStop Color="#FFEF71" Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush x:Key="CellReport.Grid.SearchHeader" StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#FFDF6B" Offset="0" />
				<GradientStop Color="#FFFCE6" Offset="1" />
			</LinearGradientBrush>
			<SolidColorBrush x:Key="CellReport.Grid.SearchHighlight" Color="#C8E8B565" />
			<SolidColorBrush x:Key="CellReport.Grid.Negative" Color="#FF0000" />
		</ResourceDictionary>

		<!-- Dark -->
		<ResourceDictionary x:Key="Dark">
			<SolidColorBrush x:Key="CellReport.Toolbar.Background" Color="#2D2D2D" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Border" Color="#3F3F46" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Separator" Color="#525252" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Hover" Color="#3A3A3A" />
			<SolidColorBrush x:Key="CellReport.Toolbar.Pressed" Color="#454545" />
			<SolidColorBrush x:Key="CellReport.Icon.Success" Color="#81C784" />
			<SolidColorBrush x:Key="CellReport.Icon.Danger" Color="#EF9A9A" />
			<SolidColorBrush x:Key="CellReport.Icon.Muted" Color="#B0B0B0" />
			<SolidColorBrush x:Key="CellReport.Icon.Accent" Color="#64B5F6" />
			<SolidColorBrush x:Key="CellReport.Error.Foreground" Color="#EF9A9A" />
			<SolidColorBrush x:Key="CellReport.Content.Background" Color="#1E1E1E" />

			<SolidColorBrush x:Key="CellReport.Grid.Background" Color="#1E1E1E" />
			<SolidColorBrush x:Key="CellReport.Grid.Foreground" Color="#E0E0E0" />
			<SolidColorBrush x:Key="CellReport.Grid.Border" Color="#555555" />
			<SolidColorBrush x:Key="CellReport.Grid.Line" Color="#3F3F46" />
			<SolidColorBrush x:Key="CellReport.Grid.AlternatingRow" Color="#332A2A2E" />
			<SolidColorBrush x:Key="CellReport.Grid.RowHover" Color="#223A3A40" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedRow" Color="#264F78" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellFocused" Color="#006CBE" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellUnfocused" Color="#3A4A5E" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedCellForeground" Color="#E0E0E0" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderBackground" Color="#2D2D30" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderForeground" Color="#D0D0D0" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderBorder" Color="#3F3F46" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderHover" Color="#3A3A40" />
			<SolidColorBrush x:Key="CellReport.Grid.HeaderSeparator" Color="#4A5A6E" />
			<SolidColorBrush x:Key="CellReport.Grid.SortableHeader" Color="#64B5F6" />
			<SolidColorBrush x:Key="CellReport.Grid.SelectedHeaderForeground" Color="#E0E0E0" />
			<LinearGradientBrush x:Key="CellReport.Grid.SelectedHeader" StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#1E1E1E" Offset="0" />
				<GradientStop Color="#006CBE" Offset="1" />
			</LinearGradientBrush>
			<LinearGradientBrush x:Key="CellReport.Grid.SearchHeader" StartPoint="0%,0%" EndPoint="0%,100%">
				<GradientStop Color="#1E1E1E" Offset="0" />
				<GradientStop Color="#006CBE" Offset="1" />
			</LinearGradientBrush>
			<SolidColorBrush x:Key="CellReport.Grid.SearchHighlight" Color="#C8E8B565" />
			<SolidColorBrush x:Key="CellReport.Grid.Negative" Color="#FFAB40" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>