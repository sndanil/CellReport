<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
        xmlns:services="clr-namespace:CellReport.Editor.Avalonia.Services"
        x:Class="CellReport.Editor.Avalonia.Views.CheckWindow"
        x:DataType="vm:CheckViewModel"
        Title="Проверка шаблона"
        Icon="avares://CellReport.Editor.Avalonia/Assets/Logo.png"
        Width="760"
        Height="480"
        MinWidth="520"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
	<Grid RowDefinitions="Auto,*,Auto">
		<Border Grid.Row="0"
		        Padding="12,8"
		        BorderBrush="{DynamicResource CellReport.Ribbon.Border}"
		        BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<TextBlock VerticalAlignment="Center"
				           FontWeight="SemiBold"
				           Text="{Binding Summary}" />
				<Button Grid.Column="1"
				        Content="Проверить снова"
				        Command="{Binding RecheckCommand}" />
			</Grid>
		</Border>

		<ListBox Grid.Row="1"
		         ItemsSource="{Binding Issues}"
		         SelectedItem="{Binding SelectedIssue}"
		         DoubleTapped="OnIssueDoubleTapped">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="services:TemplateIssue">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
						<TextBlock Text="●"
						           Foreground="{Binding Brush}"
						           VerticalAlignment="Top" />
						<TextBlock Grid.Column="1"
						           Text="{Binding Display}"
						           TextWrapping="Wrap" />
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Border Grid.Row="2"
		        Padding="12,8"
		        BorderBrush="{DynamicResource CellReport.Ribbon.Border}"
		        BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<TextBlock VerticalAlignment="Center"
				           Opacity="0.7"
				           Text="Двойной клик по замечанию — переход к ячейке" />
				<Button Grid.Column="1"
				        Content="Закрыть"
				        MinWidth="96"
				        IsCancel="True"
				        Click="OnCloseClick" />
			</Grid>
		</Border>
	</Grid>
</Window>
