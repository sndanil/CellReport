<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
             x:Class="CellReport.Editor.Avalonia.Views.StatusBarView"
             x:DataType="vm:MainWindowViewModel">
	<UserControl.Styles>
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="MinHeight" Value="24" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Border Classes="toolbar" BorderThickness="0,1,0,0">
		<Grid ColumnDefinitions="*,Auto" Margin="6,0">
			<StackPanel Grid.Column="0"
			            Orientation="Horizontal"
			            Spacing="10"
			            VerticalAlignment="Center">
				<TextBlock FontWeight="SemiBold" Text="{Binding ModeLabel}" ToolTip.Tip="Режим редактора" />
				<TextBlock Text="{Binding SaveStateLabel}" Opacity="0.85" ToolTip.Tip="Состояние документа" />
				<TextBlock Text="{Binding CellAddress}" />
				<TextBlock Text="{Binding ContentTypeLabel}" Opacity="0.7" ToolTip.Tip="Содержимое ячейки" />
				<TextBlock Text="Ширина" />
				<TextBox Width="72"
				         Text="{Binding CellWidthText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Text="Высота" />
				<TextBox Width="72"
				         Text="{Binding CellHeightText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Text="мм" />
				<TextBlock Text="{Binding SelectionStatus}" Opacity="0.85" />
			</StackPanel>

			<StackPanel Grid.Column="1"
			            Orientation="Horizontal"
			            Spacing="4"
			            VerticalAlignment="Center">
				<TextBlock Margin="0,0,10,0"
				           Opacity="0.7"
				           Text="{Binding DocumentSizeLabel}" />
				<Button Width="28"
				        Height="26"
				        MinHeight="26"
				        Padding="0"
				        HorizontalContentAlignment="Center"
				        Content="−"
				        Command="{Binding ZoomOutCommand}"
				        ToolTip.Tip="Уменьшить масштаб" />
				<TextBlock Width="54"
				           TextAlignment="Center"
				           Text="{Binding ZoomText}" />
				<Button Width="28"
				        Height="26"
				        MinHeight="26"
				        Padding="0"
				        HorizontalContentAlignment="Center"
				        Content="+"
				        Command="{Binding ZoomInCommand}"
				        ToolTip.Tip="Увеличить масштаб" />
				<Button Height="26"
				        MinHeight="26"
				        Content="100 %"
				        Command="{Binding ZoomResetCommand}"
				        ToolTip.Tip="Масштаб 100 %" />
				<Button Height="26"
				        MinHeight="26"
				        Content="По ширине"
				        Command="{Binding FitToWidthCommand}"
				        ToolTip.Tip="Вписать по ширине холста" />
			</StackPanel>
		</Grid>
	</Border>
</UserControl>
