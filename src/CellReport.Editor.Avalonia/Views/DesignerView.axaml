<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
             xmlns:report="clr-namespace:CellReport.Avalonia;assembly=CellReport.Avalonia"
             xmlns:core="clr-namespace:CellReport.Core;assembly=CellReport"
             xmlns:contents="clr-namespace:CellReport.Core.Contents;assembly=CellReport"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CellReport.Editor.Avalonia.Views.DesignerView"
             x:DataType="vm:MainWindowViewModel">
	<Grid RowDefinitions="Auto,*">
		<Border Grid.Row="0"
		        Padding="8,4"
		        BorderBrush="{DynamicResource CellReport.Ribbon.Border}"
		        BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
				<TextBlock VerticalAlignment="Center"
				           MinWidth="48"
				           Opacity="0.75"
				           Text="{Binding CellValueKindLabel}" />

				<Grid Grid.Column="1" Height="26">
					<TextBox x:Name="FormulaTextBox"
					         IsVisible="{Binding IsTextValue}"
					         MinHeight="26"
					         MaxHeight="26"
					         VerticalContentAlignment="Center"
					         Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}" />

					<TextBox x:Name="FormulaNumberTextBox"
					         IsVisible="{Binding IsNumberValue}"
					         MinHeight="26"
					         MaxHeight="26"
					         VerticalContentAlignment="Center"
					         Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />

					<CalendarDatePicker IsVisible="{Binding IsDateValue}"
					                    MinHeight="26"
					                    HorizontalAlignment="Left"
					                    SelectedDate="{Binding DateValue, Mode=TwoWay}" />

					<TextBlock IsVisible="{Binding IsNoValue}"
					           VerticalAlignment="Center"
					           TextTrimming="CharacterEllipsis"
					           Opacity="0.55"
					           Text="В ячейке нет редактируемого значения" />
				</Grid>

				<Button Grid.Column="2"
				        Width="28"
				        Height="26"
				        Padding="0"
				        IsVisible="{Binding CanExpandFormulaBar}"
				        Command="{Binding ToggleFormulaBarCommand}"
				        ToolTip.Tip="Развернуть или свернуть строку формул">
					<Panel>
						<materialIcons:MaterialIcon Kind="ChevronDown"
						                           Width="14"
						                           Height="14"
						                           IsVisible="{Binding !IsFormulaBarExpanded}" />
						<materialIcons:MaterialIcon Kind="ChevronUp"
						                           Width="14"
						                           Height="14"
						                           IsVisible="{Binding IsFormulaBarExpanded}" />
					</Panel>
				</Button>
			</Grid>
		</Border>

		<Grid Grid.Row="1" x:Name="DesignerLayout">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300" MinWidth="220" MaxWidth="720" />
				<ColumnDefinition Width="20" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

		<TabControl x:Name="InspectorTabs" Grid.Column="0" Margin="4,0,4,4">
			<TabItem Header="Параметры">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="8" Spacing="6">
						<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
							<TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Содержимое" />
							<Button Grid.Column="1" Content="Добавить" ToolTip.Tip="Добавить содержимое">
								<Button.Flyout>
									<MenuFlyout Placement="BottomEdgeAlignedRight">
										<MenuItem Header="Текст" Command="{Binding Inspector.AddTextCommand}" />
										<MenuItem Header="Число" Command="{Binding Inspector.AddDecimalCommand}" />
										<MenuItem Header="Дату и время" Command="{Binding Inspector.AddDateTimeCommand}" />
										<MenuItem Header="Штрих-код" Command="{Binding Inspector.AddBarCodeCommand}" />
										<MenuItem Header="Изображение" Command="{Binding Inspector.AddImageCommand}" />
										<MenuItem Header="Действие" Command="{Binding Inspector.AddActionCommand}" />
									</MenuFlyout>
								</Button.Flyout>
							</Button>
							<Button Grid.Column="2" Content="Удалить" Command="{Binding Inspector.RemoveSelectedContentCommand}" />
						</Grid>

						<ListBox Height="110" ItemsSource="{Binding Inspector.Contents}" SelectedItem="{Binding Inspector.SelectedContent}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:ContentRow">
									<StackPanel Spacing="1">
										<TextBlock Text="{Binding Title}" />
										<TextBlock FontSize="11"
										           Opacity="0.7"
										           TextTrimming="CharacterEllipsis"
										           IsVisible="{Binding HasDescription}"
										           Text="{Binding Description}" />
										<TextBlock FontSize="10"
										           Opacity="0.5"
										           IsVisible="{Binding HasParamsLabel}"
										           Text="{Binding ParamsLabel}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<Grid IsVisible="{Binding Inspector.IsSelectedBarCode}" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
							<TextBlock VerticalAlignment="Center" Text="Код" />
							<TextBox Grid.Column="1" Margin="0,2" Text="{Binding Inspector.BarcodeCode, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Тип" />
							<ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
							          ItemsSource="{Binding Inspector.BarcodeTypes}"
							          SelectedItem="{Binding Inspector.SelectedBarcodeType}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Ориентация" />
							<ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
							          ItemsSource="{Binding Inspector.BarcodeOrientations}"
							          SelectedItem="{Binding Inspector.SelectedBarcodeOrientation}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</Grid>

						<Grid IsVisible="{Binding Inspector.IsSelectedImage}" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
							<TextBlock VerticalAlignment="Center" Text="Адрес" />
							<TextBox Grid.Column="1" Margin="0,2" PlaceholderText="file:// или resources://"
							         Text="{Binding Inspector.ImageUri, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Объединение" />
							<StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,2">
								<TextBox Width="60" ToolTip.Tip="Столбцов" Text="{Binding Inspector.ImageColSpanText, UpdateSourceTrigger=LostFocus}" />
								<TextBlock VerticalAlignment="Center" Opacity="0.7" Text="×" />
								<TextBox Width="60" ToolTip.Tip="Строк" Text="{Binding Inspector.ImageRowSpanText, UpdateSourceTrigger=LostFocus}" />
							</StackPanel>
						</Grid>

						<Grid IsVisible="{Binding Inspector.IsSelectedAction}" ColumnDefinitions="110,*" RowSpacing="4">
							<TextBlock VerticalAlignment="Center" Text="Событие" />
							<ComboBox Grid.Column="1" Margin="0,2"
							          ItemsSource="{Binding Inspector.ActionTypes}"
							          SelectedItem="{Binding Inspector.SelectedActionType}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</Grid>

						<Separator Margin="0,2" />

						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Параметры" />
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
								<Button Content="Добавить" Command="{Binding Inspector.AddParamCommand}" />
								<Button Content="Удалить" Command="{Binding Inspector.DeleteParamCommand}" />
							</StackPanel>
						</Grid>

						<ListBox Height="90" ItemsSource="{Binding Inspector.Params}" SelectedItem="{Binding Inspector.SelectedParam}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="contents:Param">
									<TextBlock Text="{Binding Name}" />
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
							<TextBlock VerticalAlignment="Center" Text="Имя" />
							<TextBox Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamName, UpdateSourceTrigger=LostFocus}" />

							<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Цель" />
							<ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
							          ItemsSource="{Binding Inspector.ParamTargets}"
							          SelectedItem="{Binding Inspector.SelectedParamTarget}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Значение" />
							<TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
							         Text="{Binding Inspector.ParamValue, UpdateSourceTrigger=LostFocus}" />

							<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Выражение" />
							<ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
							          ItemsSource="{Binding Inspector.Expressions}"
							          SelectedItem="{Binding Inspector.SelectedParamExpression}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,6,0,0" Text="Формат" />
							<StackPanel Grid.Row="4" Grid.Column="1" Margin="0,2" Spacing="2">
								<AutoCompleteBox IsEnabled="{Binding Inspector.HasSelectedParam}"
								                Text="{Binding Inspector.ParamFormat, UpdateSourceTrigger=LostFocus}"
								                ItemsSource="{Binding Inspector.FormatPresets}"
								                MinimumPrefixLength="0"
								                PlaceholderText="Например: #,##0.00" />
								<TextBlock FontSize="11" Opacity="0.65" Text="{Binding Inspector.ParamFormatPreview}" />
							</StackPanel>

							<TextBlock Grid.Row="5" VerticalAlignment="Top" Margin="0,6,0,0" Text="Культура" />
							<StackPanel Grid.Row="5" Grid.Column="1" Margin="0,2" Spacing="2">
								<AutoCompleteBox IsEnabled="{Binding Inspector.HasSelectedParam}"
								                Text="{Binding Inspector.ParamCulture, UpdateSourceTrigger=LostFocus}"
								                ItemsSource="{Binding Inspector.Cultures}"
								                PlaceholderText="ru-RU" />
								<TextBlock FontSize="11" Opacity="0.65" Text="{Binding Inspector.ParamCultureName}" />
							</StackPanel>

							<TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Тип" />
							<ComboBox Grid.Row="6" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
							          ItemsSource="{Binding Inspector.ParamTypes}"
							          SelectedItem="{Binding Inspector.SelectedParamType}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:Choice">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Присвоить" />
							<TextBox Grid.Row="7" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamAssign, UpdateSourceTrigger=LostFocus}" />
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Секции">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="8" Spacing="6">
						<ListBox Height="140" ItemsSource="{Binding Inspector.Sections}" SelectedItem="{Binding Inspector.SelectedSection}">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="core:TemplateSection">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="{Binding Name}" />
										<TextBlock Text="{Binding ObjectName}" Opacity="0.7" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<Grid ColumnDefinitions="*,*">
							<Button Content="Добавить" Command="{Binding Inspector.AddSectionCommand}" />
							<Button Grid.Column="1" Margin="6,0,0,0" Content="Удалить" Command="{Binding Inspector.DeleteSectionCommand}" />
						</Grid>
						<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
							<TextBlock VerticalAlignment="Center" Text="Имя" />
							<TextBox Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionName, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Имя объекта" />
							<TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionObjectName, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Лево" />
							<TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionLeft, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Верх" />
							<TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionTop, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Право" />
							<TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionRight, UpdateSourceTrigger=LostFocus}" />
							<TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Низ" />
							<TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionBottom, UpdateSourceTrigger=LostFocus}" />
							<Button Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalAlignment="Stretch"
							        Content="Установить"
							        Command="{Binding Inspector.SetSectionBoundsCommand}" />
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Ячейка">
				<StackPanel Margin="8" Spacing="8">
					<CheckBox IsChecked="{Binding Inspector.AutoHeight}" Content="Автовысота строки" />
					<TextBlock Text="Маркер отображения" />
					<TextBox Text="{Binding Inspector.MarkerForShow, UpdateSourceTrigger=LostFocus}" />
					<TextBlock Text="Маркер сокрытия" />
					<TextBox Text="{Binding Inspector.MarkerForHide, UpdateSourceTrigger=LostFocus}" />
				</StackPanel>
			</TabItem>
		</TabControl>

		<Border Grid.Column="1"
		        Background="{DynamicResource CellReport.Ribbon.TabBg}"
		        BorderBrush="{DynamicResource CellReport.Ribbon.Border}"
		        BorderThickness="1,0,1,0"
		        IsHitTestVisible="False" />

		<GridSplitter Grid.Column="1"
		              ResizeDirection="Columns"
		              Background="Transparent"
		              IsEnabled="{Binding !IsInspectorCollapsed}" />

		<materialIcons:MaterialIcon Grid.Column="1"
		                           Kind="DragVertical"
		                           Width="12"
		                           Height="18"
		                           Opacity="0.4"
		                           HorizontalAlignment="Center"
		                           VerticalAlignment="Center"
		                           IsHitTestVisible="False" />

		<Button Grid.Column="1"
		        Height="32"
		        Padding="0"
		        HorizontalAlignment="Stretch"
		        VerticalAlignment="Top"
		        Background="Transparent"
		        BorderThickness="0"
		        CornerRadius="0"
		        Command="{Binding ToggleInspectorCommand}"
		        ToolTip.Tip="Свернуть или развернуть панель">
			<Panel>
				<materialIcons:MaterialIcon Kind="ChevronLeft"
				                           Width="16"
				                           Height="16"
				                           IsVisible="{Binding !IsInspectorCollapsed}" />
				<materialIcons:MaterialIcon Kind="ChevronRight"
				                           Width="16"
				                           Height="16"
				                           IsVisible="{Binding IsInspectorCollapsed}" />
			</Panel>
		</Button>

			<Grid Grid.Column="2">
				<report:PresentControl x:Name="ReportSurface"
				                       DataContext="{Binding Present}"
				                       InvertContentMode="Never" />

				<Canvas x:Name="InlineEditorLayer">
					<TextBox x:Name="InlineEditor"
					         IsVisible="False"
					         AcceptsReturn="True"
					         TextWrapping="Wrap"
					         Padding="2"
					         BorderThickness="1"
					         VerticalContentAlignment="Top"
					         FontFamily="Consolas, Cascadia Mono, monospace" />
				</Canvas>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
