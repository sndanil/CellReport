<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
             x:Class="CellReport.Editor.Avalonia.Views.DocumentSettingsView"
             x:DataType="vm:MainWindowViewModel">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="16" Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
			<TextBlock FontWeight="SemiBold" Text="Документ" />
			<Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
				<TextBlock VerticalAlignment="Center" Text="Имя документа" />
				<StackPanel Grid.Column="1" Margin="0,2" Spacing="2">
					<TextBox Text="{Binding Settings.DocumentName, UpdateSourceTrigger=LostFocus}" />
					<TextBlock FontSize="11"
					           Opacity="0.7"
					           IsVisible="{Binding Settings.HasDocumentNamePreview}"
					           Text="{Binding Settings.DocumentNamePreview, StringFormat='Отображается как: {0}'}" />
				</StackPanel>
				<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Культура" />
				<TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Settings.Culture, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Столбцов по умолчанию" />
				<TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultColumnsCountText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Строк по умолчанию" />
				<TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultRowsCountText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Ширина столбца по умолчанию, мм" />
				<TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultColumnWidthText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Высота строки по умолчанию, мм" />
				<TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultRowHeightText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Маркер отображения столбца" />
				<TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultMarkerForShow, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Маркер сокрытия столбца" />
				<TextBox Grid.Row="7" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultMarkerForHide, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Культура локализации" />
				<TextBox Grid.Row="8" Grid.Column="1" Margin="0,2" Text="{Binding Settings.DefaultCulture, UpdateSourceTrigger=LostFocus}" />
			</Grid>

			<Grid ColumnDefinitions="*,Auto">
				<TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Строки локализации" />
				<Button Grid.Column="1" Content="Добавить" Command="{Binding Settings.AddLocalizationCommand}" />
			</Grid>
			<ItemsControl ItemsSource="{Binding Settings.Strings}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:LocalizationEdit">
						<Grid Margin="0,0,0,6" ColumnDefinitions="140,220,*,Auto" ColumnSpacing="6">
							<TextBox PlaceholderText="Культура" Text="{Binding Culture, UpdateSourceTrigger=LostFocus}" />
							<TextBox Grid.Column="1" PlaceholderText="Идентификатор" Text="{Binding Id, UpdateSourceTrigger=LostFocus}" />
							<TextBox Grid.Column="2" PlaceholderText="Значение" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
							<Button Grid.Column="3" Content="Удалить" Command="{Binding RemoveCommand}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock FontWeight="SemiBold" Text="Экспорт" />
			<CheckBox Content="Запускать Excel после экспорта" IsChecked="{Binding Settings.RunExcelAfterExport}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>

