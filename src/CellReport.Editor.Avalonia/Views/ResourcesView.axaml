<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
             x:Class="CellReport.Editor.Avalonia.Views.ResourcesView"
             x:DataType="vm:MainWindowViewModel">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="16" Spacing="10" MaxWidth="1000" HorizontalAlignment="Left">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
				<StackPanel Spacing="2">
					<TextBlock FontWeight="SemiBold" Text="Ресурсы" />
					<TextBlock FontSize="12" Opacity="0.7" Text="{Binding Resources.Summary}" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<Button Content="Добавить…" Command="{Binding Resources.AddCommand}" />
					<Button Content="Встроить все" Command="{Binding Resources.EmbedAllCommand}" />
				</StackPanel>
			</Grid>

			<Border IsVisible="{Binding Resources.IsXmlDocument}"
			        Padding="10"
			        CornerRadius="4"
			        BorderThickness="1"
			        BorderBrush="{DynamicResource CellReport.Ribbon.Border}">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
					<TextBlock VerticalAlignment="Center"
					           TextWrapping="Wrap"
					           Opacity="0.85"
					           Text="Шаблон сохраняется как XML (.tcr): ресурсы в него не попадут. Сохраните шаблон как упакованный (.tcrp)." />
					<Button Grid.Column="1"
					        Content="Сохранить как пакет…"
					        Command="{Binding Resources.SaveAsPackageCommand}" />
				</Grid>
			</Border>

			<TextBlock FontSize="12"
			           Opacity="0.85"
			           TextWrapping="Wrap"
			           IsVisible="{Binding Resources.HasMessage}"
			           Text="{Binding Resources.Message}" />

			<ListBox Height="150"
			         ItemsSource="{Binding Resources.Resources}"
			         SelectedItem="{Binding Resources.SelectedResource}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ResourceRow">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<StackPanel Spacing="1">
								<TextBlock FontWeight="SemiBold"
								           TextTrimming="CharacterEllipsis"
								           Text="{Binding Name}" />
								<TextBlock FontSize="11" Opacity="0.7" Text="{Binding SizeText}" />
							</StackPanel>
							<TextBlock Grid.Column="1"
							           VerticalAlignment="Center"
							           FontSize="11"
							           Opacity="0.7"
							           Text="{Binding UsageText}" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<Border IsVisible="{Binding Resources.HasSelection}"
			        Padding="10"
			        CornerRadius="4"
			        BorderThickness="1"
			        BorderBrush="{DynamicResource CellReport.Ribbon.Border}">
				<Grid ColumnDefinitions="110,*" ColumnSpacing="12">
					<Border Width="96" Height="96" CornerRadius="4" Background="#22808080">
						<Image Source="{Binding Resources.Preview}" Stretch="Uniform" Margin="4" />
					</Border>
					<StackPanel Grid.Column="1" Spacing="8">
						<TextBlock TextWrapping="Wrap" Opacity="0.8" Text="{Binding Resources.Details}" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<TextBox Text="{Binding Resources.RenameText, UpdateSourceTrigger=PropertyChanged}" />
							<Button Grid.Column="1" Content="Переименовать" Command="{Binding Resources.RenameCommand}" />
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Button Content="Заменить…" Command="{Binding Resources.ReplaceCommand}" />
							<Button Content="Извлечь…" Command="{Binding Resources.ExtractCommand}" />
							<Button Content="Удалить" Command="{Binding Resources.RemoveCommand}" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>

			<Separator />

			<TextBlock FontWeight="SemiBold" Text="Внешние изображения" />
			<TextBlock IsVisible="{Binding !Resources.HasExternalImages}"
			           Opacity="0.7"
			           TextWrapping="Wrap"
			           Text="Внешних изображений нет. Изображения, подключённые по file://, можно встроить в шаблон." />
			<ItemsControl ItemsSource="{Binding Resources.ExternalImages}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:ExternalImageRow">
						<Border Margin="0,0,0,6"
						        Padding="8"
						        CornerRadius="4"
						        BorderThickness="1"
						        BorderBrush="{DynamicResource CellReport.Ribbon.Border}">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<StackPanel Spacing="1">
									<TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Uri}" />
									<TextBlock FontSize="11" Opacity="0.7" Text="{Binding StatusText}" />
									<TextBlock FontSize="11" Opacity="0.7" Text="{Binding UsageText}" />
								</StackPanel>
								<Button Grid.Column="1"
								        VerticalAlignment="Center"
								        Content="Встроить"
								        Command="{Binding EmbedCommand}" />
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</ScrollViewer>
</UserControl>
