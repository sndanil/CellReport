<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
        xmlns:views="clr-namespace:CellReport.Editor.Avalonia.Views"
        x:Class="CellReport.Editor.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100"
        Height="720"
        WindowState="Maximized">
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding CreateCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
		<KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
		<KeyBinding Gesture="Ctrl+H" Command="{Binding FindAndReplaceCommand}" />
		<KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowSettingsCommand}" />
	</Window.KeyBindings>

	<Grid RowDefinitions="Auto,*,Auto">
		<views:RibbonView Grid.Row="0" />

		<TabControl x:Name="ModeTabs" Grid.Row="1" SelectionChanged="OnModeChanged">
			<TabItem x:Name="DesignerTab" Header="Конструктор">
				<views:DesignerView x:Name="DesignerPane" />
			</TabItem>
			<TabItem x:Name="CodeTab" Header="{Binding CodeTabTitle}">
				<views:CodeView x:Name="CodePane" />
			</TabItem>
		</TabControl>

		<views:StatusBarView Grid.Row="2" />
	</Grid>
</Window>
