<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CellReport.Editor.Avalonia.ViewModels"
        xmlns:report="clr-namespace:CellReport.Avalonia;assembly=CellReport.Avalonia"
        xmlns:core="clr-namespace:CellReport.Core;assembly=CellReport"
        xmlns:contents="clr-namespace:CellReport.Core.Contents;assembly=CellReport"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CellReport.Editor.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100"
        Height="720"
        WindowState="Maximized">
	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding CreateCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
		<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
		<KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
		<KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
		<KeyBinding Gesture="Ctrl+C" Command="{Binding Inspector.CopyCommand}" />
		<KeyBinding Gesture="Ctrl+X" Command="{Binding Inspector.CutCommand}" />
		<KeyBinding Gesture="Ctrl+V" Command="{Binding Inspector.PasteCommand}" />
		<KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
		<KeyBinding Gesture="Ctrl+H" Command="{Binding FindAndReplaceCommand}" />
		<KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleBoldCommand}" />
		<KeyBinding Gesture="Ctrl+I" Command="{Binding ToggleItalicCommand}" />
		<KeyBinding Gesture="Ctrl+U" Command="{Binding ToggleUnderlineCommand}" />
	</Window.KeyBindings>

	<Grid RowDefinitions="Auto,*,Auto">
		<Border Grid.Row="0" Classes="ribbon">
			<DockPanel>
				<Border Classes="ribbon-tabs" DockPanel.Dock="Top">
					<DockPanel>
						<Button Classes="ribbon-ops" DockPanel.Dock="Left" Content="Файл">
							<Button.Flyout>
								<MenuFlyout Placement="BottomEdgeAlignedLeft">
									<MenuItem Header="Создать" InputGesture="Ctrl+N" Command="{Binding CreateCommand}" />
								<MenuItem Header="Открыть" InputGesture="Ctrl+O" Command="{Binding OpenCommand}" />
								<MenuItem Header="Импорт" Command="{Binding ImportCommand}" />
								<Separator />
									<MenuItem Header="Сохранить" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
									<MenuItem Header="Сохранить как" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
									<Separator />
									<MenuItem Header="Предварительный просмотр" Command="{Binding PrintPreviewCommand}" />
									<MenuItem Header="Печать" Command="{Binding PrintCommand}" />
									<Separator />
									<MenuItem Header="Выход" Command="{Binding ExitCommand}" />
								</MenuFlyout>
							</Button.Flyout>
						</Button>
						<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
							<Button Classes="ribbon-chrome" Command="{Binding SaveCommand}" ToolTip.Tip="Сохранить">
								<materialIcons:MaterialIcon Kind="ContentSave" />
							</Button>
							<Button Classes="ribbon-chrome" Command="{Binding UndoCommand}" ToolTip.Tip="Отменить">
								<materialIcons:MaterialIcon Kind="Undo" />
							</Button>
							<Button Classes="ribbon-chrome" Command="{Binding RedoCommand}" ToolTip.Tip="Вернуть">
								<materialIcons:MaterialIcon Kind="Redo" />
							</Button>
						</StackPanel>
						<StackPanel Orientation="Horizontal">
							<Button Classes="ribbon-tab"
							        Classes.selected="{Binding IsHomeRibbon}"
							        Content="Главная"
							        Command="{Binding SelectRibbonTabCommand}"
							        CommandParameter="0" />
							<Button Classes="ribbon-tab"
							        Classes.selected="{Binding IsCellsRibbon}"
							        Content="Ячейки"
							        Command="{Binding SelectRibbonTabCommand}"
							        CommandParameter="1" />
							<Button Classes="ribbon-tab"
							        Classes.selected="{Binding IsContentRibbon}"
							        Content="Содержимое"
							        Command="{Binding SelectRibbonTabCommand}"
							        CommandParameter="2" />
						</StackPanel>
					</DockPanel>
				</Border>

				<Border Classes="ribbon-content">
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
						<Panel>
							<StackPanel Classes="ribbon-groups" IsVisible="{Binding IsHomeRibbon}">
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Буфер обмена" />
										<StackPanel Margin="4,4,4,2">
											<Button Classes="ribbon-button compact" Command="{Binding Inspector.CutCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="ContentCut" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Вырезать" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button compact" Command="{Binding Inspector.CopyCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Копировать" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button compact" Command="{Binding Inspector.PasteCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="ContentPaste" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Вставить" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Действия" />
										<StackPanel Margin="4,4,4,2">
											<Button Classes="ribbon-button compact" Command="{Binding UndoCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="Undo" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Отменить" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button compact" Command="{Binding RedoCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="Redo" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Вернуть" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Поиск" />
										<StackPanel Margin="4,4,4,2">
											<Button Classes="ribbon-button compact" Command="{Binding FindCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Найти" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button compact" Command="{Binding FindAndReplaceCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="FindReplace" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Найти и заменить" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button compact" Command="{Binding FindInCodeCommand}">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="FileSearchOutline" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Найти строку в коде" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Шрифт" />
										<StackPanel Margin="4,4,4,2" Orientation="Vertical" Spacing="2">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<ComboBox Width="148"
												          ItemsSource="{Binding Fonts}"
												          SelectedItem="{Binding FontFamily}"
												          IsEnabled="{Binding IsTextableContent}" />
												<ComboBox Width="68"
												          ItemsSource="{Binding FontSizes}"
												          SelectedItem="{Binding FontSize}"
												          IsEnabled="{Binding IsTextableContent}" />
											</StackPanel>
											<StackPanel Orientation="Horizontal" Spacing="2">
												<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding FontBold}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="Полужирный (Ctrl+B)">
													<materialIcons:MaterialIcon Kind="FormatBold" Width="16" Height="16" />
												</ToggleButton>
												<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding FontItalic}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="Курсив (Ctrl+I)">
													<materialIcons:MaterialIcon Kind="FormatItalic" Width="16" Height="16" />
												</ToggleButton>
												<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding FontUnderline}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="Подчёркивание (Ctrl+U)">
													<materialIcons:MaterialIcon Kind="FormatUnderline" Width="16" Height="16" />
												</ToggleButton>
												<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding FontStrikeout}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="Зачёркивание">
													<materialIcons:MaterialIcon Kind="FormatStrikethrough" Width="16" Height="16" />
												</ToggleButton>
												<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AutoFitFont}" IsEnabled="{Binding IsTextContent}" ToolTip.Tip="Автоматический размер шрифта">
													<materialIcons:MaterialIcon Kind="FormatFontSizeDecrease" Width="16" Height="16" />
												</ToggleButton>
											</StackPanel>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Выравнивание" />
										<StackPanel Orientation="Horizontal" Margin="4,4,4,2" Spacing="8">
											<StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
												<StackPanel Orientation="Horizontal" Spacing="2">
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignTop}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По верхнему краю">
														<materialIcons:MaterialIcon Kind="FormatAlignTop" Width="16" Height="16" />
													</ToggleButton>
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignMiddle}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По середине">
														<materialIcons:MaterialIcon Kind="FormatAlignMiddle" Width="16" Height="16" />
													</ToggleButton>
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignBottom}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По нижнему краю">
														<materialIcons:MaterialIcon Kind="FormatAlignBottom" Width="16" Height="16" />
													</ToggleButton>
												</StackPanel>
												<StackPanel Orientation="Horizontal" Spacing="2">
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignLeft}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По левому краю">
														<materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="16" Height="16" />
													</ToggleButton>
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignCenter}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По центру">
														<materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="16" Height="16" />
													</ToggleButton>
													<ToggleButton Classes="ribbon-toggle" IsChecked="{Binding AlignRight}" IsEnabled="{Binding IsTextableContent}" ToolTip.Tip="По правому краю">
														<materialIcons:MaterialIcon Kind="FormatAlignRight" Width="16" Height="16" />
													</ToggleButton>
												</StackPanel>
											</StackPanel>
											<Button Classes="ribbon-button compact" Command="{Binding Inspector.MergeCellsCommand}" VerticalAlignment="Center">
												<StackPanel Orientation="Horizontal" Spacing="4">
													<materialIcons:MaterialIcon Kind="TableMergeCells" Width="16" Height="16" Classes="icon-muted" />
													<TextBlock Text="Объединить ячейки" VerticalAlignment="Center" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
							</StackPanel>

							<StackPanel Classes="ribbon-groups" IsVisible="{Binding IsCellsRibbon}">
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Ячейки" />
										<StackPanel Orientation="Horizontal" Margin="4,4,4,2">
											<Button Classes="ribbon-button large" Command="{Binding Inspector.DeleteCellCommand}">
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="TableRemove" Width="32" Height="32" Classes="icon-danger" />
													<TextBlock Text="Удалить" MaxWidth="72" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Строки и столбцы" />
										<StackPanel Orientation="Horizontal" Margin="4,4,4,2">
											<Button Classes="ribbon-button large">
												<Button.Flyout>
													<MenuFlyout Placement="BottomEdgeAlignedLeft">
														<MenuItem Header="Вставить до" Command="{Binding Inspector.InsertRowBeforeCommand}" />
														<MenuItem Header="Вставить после" Command="{Binding Inspector.InsertRowAfterCommand}" />
													</MenuFlyout>
												</Button.Flyout>
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="TableRowPlusBefore" Width="32" Height="32" Classes="icon-success" />
													<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
														<TextBlock Text="Добавить строку" MaxWidth="64" />
														<materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
													</StackPanel>
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button large" Command="{Binding Inspector.DeleteRowsCommand}">
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="TableRowRemove" Width="32" Height="32" Classes="icon-danger" />
													<TextBlock Text="Удалить строку" MaxWidth="72" />
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button large">
												<Button.Flyout>
													<MenuFlyout Placement="BottomEdgeAlignedLeft">
														<MenuItem Header="Вставить до" Command="{Binding Inspector.InsertColumnBeforeCommand}" />
														<MenuItem Header="Вставить после" Command="{Binding Inspector.InsertColumnAfterCommand}" />
													</MenuFlyout>
												</Button.Flyout>
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="TableColumnPlusBefore" Width="32" Height="32" Classes="icon-success" />
													<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
														<TextBlock Text="Добавить столбец" MaxWidth="68" />
														<materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
													</StackPanel>
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button large" Command="{Binding Inspector.DeleteColumnsCommand}">
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="TableColumnRemove" Width="32" Height="32" Classes="icon-danger" />
													<TextBlock Text="Удалить столбец" MaxWidth="72" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Стиль" />
										<StackPanel Width="180" Margin="8,8,8,2" VerticalAlignment="Center">
											<ComboBox ItemsSource="{Binding Inspector.CellStyles}"
											          SelectedItem="{Binding Inspector.SelectedCellStyle}" />
										</StackPanel>
									</DockPanel>
								</Border>
							</StackPanel>

							<StackPanel Classes="ribbon-groups" IsVisible="{Binding IsContentRibbon}">
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Контент" />
										<StackPanel Orientation="Horizontal" Margin="4,4,4,2">
											<Button Classes="ribbon-button large">
												<Button.Flyout>
													<MenuFlyout Placement="BottomEdgeAlignedLeft">
														<MenuItem Header="Текст" Command="{Binding Inspector.AddTextCommand}" />
														<MenuItem Header="Число" Command="{Binding Inspector.AddDecimalCommand}" />
														<MenuItem Header="Дату и время" Command="{Binding Inspector.AddDateTimeCommand}" />
														<MenuItem Header="Штрих-код" Command="{Binding Inspector.AddBarCodeCommand}" />
														<MenuItem Header="Изображение" Command="{Binding Inspector.AddImageCommand}" />
														<MenuItem Header="Действие" Command="{Binding Inspector.AddActionCommand}" />
													</MenuFlyout>
												</Button.Flyout>
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="PlusBoxOutline" Width="32" Height="32" Classes="icon-success" />
													<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
														<TextBlock Text="Добавить" MaxWidth="72" />
														<materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
													</StackPanel>
												</StackPanel>
											</Button>
											<Button Classes="ribbon-button large" Command="{Binding Inspector.DeleteContentCommand}">
												<StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
													<materialIcons:MaterialIcon Kind="DeleteOutline" Width="32" Height="32" Classes="icon-danger" />
													<TextBlock Text="Удалить все" MaxWidth="72" />
												</StackPanel>
											</Button>
										</StackPanel>
									</DockPanel>
								</Border>
								<Border Classes="ribbon-group">
									<DockPanel LastChildFill="True">
										<TextBlock Classes="ribbon-group-title" DockPanel.Dock="Bottom" Text="Стиль" />
										<StackPanel Orientation="Horizontal" Margin="4,8,4,2" VerticalAlignment="Center">
											<StackPanel Width="150" Margin="4,0">
												<TextBlock FontSize="11" Margin="0,0,0,2" Opacity="0.8" Text="Текст" />
												<ComboBox IsEnabled="{Binding Inspector.HasTextContent}"
												          ItemsSource="{Binding Inspector.TextStyles}"
												          SelectedItem="{Binding Inspector.SelectedTextStyle}" />
											</StackPanel>
											<StackPanel Width="150" Margin="4,0">
												<TextBlock FontSize="11" Margin="0,0,0,2" Opacity="0.8" Text="Число" />
												<ComboBox IsEnabled="{Binding Inspector.HasDecimalContent}"
												          ItemsSource="{Binding Inspector.DecimalStyles}"
												          SelectedItem="{Binding Inspector.SelectedDecimalStyle}" />
											</StackPanel>
											<StackPanel Width="150" Margin="4,0">
												<TextBlock FontSize="11" Margin="0,0,0,2" Opacity="0.8" Text="Дата" />
												<ComboBox IsEnabled="{Binding Inspector.HasDateTimeContent}"
												          ItemsSource="{Binding Inspector.DateTimeStyles}"
												          SelectedItem="{Binding Inspector.SelectedDateTimeStyle}" />
											</StackPanel>
										</StackPanel>
									</DockPanel>
								</Border>
							</StackPanel>
						</Panel>
					</ScrollViewer>
				</Border>
			</DockPanel>
		</Border>

		<TabControl x:Name="ModeTabs" Grid.Row="1" SelectionChanged="OnModeChanged">
			<TabItem Header="Конструктор">
				<Grid RowDefinitions="Auto,*">
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,6">
			<TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Текст" />
			<TextBox Grid.Column="1"
			         Height="56"
			         AcceptsReturn="True"
			         TextWrapping="Wrap"
			         FontFamily="Consolas, Cascadia Mono, monospace"
			         IsEnabled="{Binding IsTextContent}"
			         Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}" />
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="300,*">
			<TabControl Margin="4,0,4,4">
				<TabItem Header="Параметры">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="8" Spacing="6">
							<TextBlock Text="Содержимое" />
							<ListBox Height="90" ItemsSource="{Binding Inspector.Contents}" SelectedItem="{Binding Inspector.SelectedContent}" />
							<Grid ColumnDefinitions="*,*">
								<Button Content="Параметр" Command="{Binding Inspector.AddParamCommand}" />
								<Button Grid.Column="1" Margin="6,0,0,0" Content="Удалить" Command="{Binding Inspector.DeleteParamCommand}" />
							</Grid>
							<ListBox Height="90" ItemsSource="{Binding Inspector.Params}" SelectedItem="{Binding Inspector.SelectedParam}">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="contents:Param">
										<TextBlock Text="{Binding Name}" />
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
								<TextBlock VerticalAlignment="Center" Text="Имя" />
								<TextBox Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamName, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Значение" />
								<TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamValue, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Цель" />
								<ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
								          ItemsSource="{Binding Inspector.ParamTargets}"
								          SelectedItem="{Binding Inspector.SelectedParamTarget}" />
								<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Выражение" />
								<TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamExpression, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Формат" />
								<TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamFormat, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Культура" />
								<TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamCulture, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Тип" />
								<ComboBox Grid.Row="6" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}"
								          ItemsSource="{Binding Inspector.ParamTypes}"
								          SelectedItem="{Binding Inspector.SelectedParamType}" />
								<TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Присвоить" />
								<TextBox Grid.Row="7" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedParam}" Text="{Binding Inspector.ParamAssign, UpdateSourceTrigger=LostFocus}" />
							</Grid>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
				<TabItem Header="Секции">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="8" Spacing="6">
							<ListBox Height="140" ItemsSource="{Binding Inspector.Sections}" SelectedItem="{Binding Inspector.SelectedSection}">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="core:TemplateSection">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<TextBlock Text="{Binding Name}" />
											<TextBlock Text="{Binding ObjectName}" Opacity="0.7" />
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Grid ColumnDefinitions="*,*">
								<Button Content="Добавить" Command="{Binding Inspector.AddSectionCommand}" />
								<Button Grid.Column="1" Margin="6,0,0,0" Content="Удалить" Command="{Binding Inspector.DeleteSectionCommand}" />
							</Grid>
							<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
								<TextBlock VerticalAlignment="Center" Text="Имя" />
								<TextBox Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionName, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Имя объекта" />
								<TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionObjectName, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Лево" />
								<TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionLeft, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Верх" />
								<TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionTop, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Право" />
								<TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionRight, UpdateSourceTrigger=LostFocus}" />
								<TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Низ" />
								<TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" IsEnabled="{Binding Inspector.HasSelectedSection}" Text="{Binding Inspector.SectionBottom, UpdateSourceTrigger=LostFocus}" />
								<Button Grid.Row="6" Grid.ColumnSpan="2" Margin="0,4,0,0" HorizontalAlignment="Stretch"
								        Content="Установить"
								        Command="{Binding Inspector.SetSectionBoundsCommand}" />
							</Grid>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
				<TabItem Header="Ячейка">
					<StackPanel Margin="8" Spacing="8">
						<CheckBox IsChecked="{Binding Inspector.AutoHeight}" Content="Автовысота строки" />
						<TextBlock Text="Маркер отображения" />
						<TextBox Text="{Binding Inspector.MarkerForShow, UpdateSourceTrigger=LostFocus}" />
						<TextBlock Text="Маркер сокрытия" />
						<TextBox Text="{Binding Inspector.MarkerForHide, UpdateSourceTrigger=LostFocus}" />
					</StackPanel>
				</TabItem>
			</TabControl>

			<report:PresentControl Grid.Column="1" DataContext="{Binding Present}" />
			</Grid>
		</Grid>
			</TabItem>
			<TabItem Header="Код">
				<Grid RowDefinitions="*,6,160">
					<edit:TextEditor x:Name="CodeEditor"
					                 FontFamily="Consolas, Cascadia Mono, monospace"
					                 FontSize="14"
					                 HorizontalScrollBarVisibility="Auto"
					                 VerticalScrollBarVisibility="Auto" />
					<GridSplitter Grid.Row="1" ResizeDirection="Rows" />
					<ListBox x:Name="ErrorList"
					         Grid.Row="2"
					         ItemsSource="{Binding CodeErrors}"
					         SelectionChanged="OnErrorSelected">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:SchemaError">
								<TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</TabItem>
		</TabControl>

		<Border Grid.Row="2" Classes="toolbar" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="Auto,Auto,88,Auto,88,Auto,Auto,*,Auto,110" Margin="4,0">
				<TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="4,0" Text="{Binding CellAddress}" />
				<TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Ширина" />
				<TextBox Grid.Column="2"
				         Margin="6,4"
				         VerticalAlignment="Center"
				         Text="{Binding CellWidthText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Высота" />
				<TextBox Grid.Column="4"
				         Margin="6,4"
				         VerticalAlignment="Center"
				         Text="{Binding CellHeightText, UpdateSourceTrigger=LostFocus}" />
				<TextBlock Grid.Column="5" VerticalAlignment="Center" Text="мм" />
				<TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="8,0" Text="{Binding SelectionStatus}" />
				<TextBlock Grid.Column="8" VerticalAlignment="Center" Margin="0,0,8,0" Text="Масштаб" />
				<ComboBox Grid.Column="9"
				          Margin="0,4,4,4"
				          VerticalAlignment="Center"
				          ItemsSource="{Binding Present.ScaleOptions}"
				          SelectedIndex="{Binding Present.SelectedScaleIndex}" />
			</Grid>
		</Border>
	</Grid>
</Window>
