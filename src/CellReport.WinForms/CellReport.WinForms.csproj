<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
		<AssemblyVersion>0.11.2605.0311</AssemblyVersion>
		<FileVersion>0.11.2605.0311</FileVersion>
		<Copyright>Copyright © Daniil Safonov 2011-2025</Copyright>
		<Company>Daniil Safonov</Company>

		<IsPackable>true</IsPackable>
		<Description>CellReport для WinForms: просмотр, печать и GDI+-рендерер</Description>
		<PackageTags>reporting;winforms;printing;net48;net8</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ZXing.Net" Version="0.16.10" />
		<PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CellReport\CellReport.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Resources.Extensions" Version="9.0.1" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(TargetFramework)' == 'net48' ">
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(SkipBuildNumerator)' != 'true'">
		<Exec Command="$(SolutionDir)buildnumerator.exe $(ProjectDir) $(ConfigurationName)" />
	</Target>

</Project>
