<?xml version="1.0" encoding="utf-8" ?>
<CellReportTemplate>
  <Styles>
    <CellStyle ID="ЖирнаяЛинияВнизу">
      <Borders>
        <Border Position="Bottom" Style="Solid" Color="Black" Weight="0.5" />
      </Borders>
    </CellStyle>
    <CellStyle ID="ЗаголовокТаблицы" Color="#C0C0C0">
      <Borders>
        <Border Position="All" Style="Solid" Color="Black" Weight="0.3527778" />
      </Borders>
    </CellStyle>
    <CellStyle ID="Содержимое">
      <Borders>
        <Border Position="All" Style="Solid" Color="Black" Weight="0.3" />
      </Borders>
    </CellStyle>

    <TextContentStyle ID="ЗаголовокТаблицы" Color="Black" Direction="LeftToRight" Angle="0">
      <Alignment Horizontal="Center" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Bold" />
    </TextContentStyle>
    <TextContentStyle ID="Заголовок" Color="Black" Direction="LeftToRight" Angle="0">
      <Alignment Horizontal="Left" Vertical="Middle" />
      <Font Family="Arial" Size="11.25" Style="Bold" />
    </TextContentStyle>
    <TextContentStyle ID="Текст" Color="Black" Direction="LeftToRight" Angle="0">
      <Alignment Horizontal="Left" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </TextContentStyle>

    <DecimalContentStyle ID="Деньги" Color="Black" Direction="LeftToRight" Angle="0" Format="#,##0.00;-#,##0.00;-" Culture="ru-RU" NegativeColor="Red">
      <Alignment Horizontal="Right" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </DecimalContentStyle>
    <DecimalContentStyle ID="ЦелоеПусто" Color="Black" Direction="LeftToRight" Angle="0" Format="#,##0;-#,##0; " Culture="ru-RU" NegativeColor="Red">
      <Alignment Horizontal="Right" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </DecimalContentStyle>
    <DecimalContentStyle ID="Целое" Color="Black" Direction="LeftToRight" Angle="0" Format="#,##0;-#,##0;-" Culture="ru-RU" NegativeColor="Red">
      <Alignment Horizontal="Right" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </DecimalContentStyle>
    <DecimalContentStyle ID="Количество" Color="Black" Direction="LeftToRight" Angle="0" Format="#,##0.000;-#,##0.000;-" Culture="ru-RU" NegativeColor="Red">
      <Alignment Horizontal="Right" Vertical="Middle" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </DecimalContentStyle>

    <DateTimeContentStyle ID="ДатаВремя" Color="Black" Direction="LeftToRight" Angle="0" Format="dd.MM.yyyy HH:mm" Culture="ru-RU">
      <Alignment Horizontal="Left" Vertical="Top" />
      <Font Family="Arial" Size="8.25" Style="Regular" />
    </DateTimeContentStyle>
  </Styles>
</CellReportTemplate>
