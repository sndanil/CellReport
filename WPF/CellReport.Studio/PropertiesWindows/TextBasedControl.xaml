<UserControl x:Class="CellReport.Studio.PropertiesWindows.TextBasedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:CellReport.Studio.PropertiesWindows"
            xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27" />
            <RowDefinition Height="90" />
            <RowDefinition Height="27" />
            <RowDefinition Height="40" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2">Идентификатор</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ID}" Margin="2" />

        <local:FontControl Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Font}">
        </local:FontControl>

        <TextBlock Grid.Row="2" VerticalAlignment="Center">Цвет</TextBlock>
        <extToolkit:ColorPicker Grid.Row="2" Grid.Column="1" SelectedColor="{Binding Color}" Margin="2" x:Name="color" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Orientation="Horizontal">
            <ToggleButton IsChecked="{Binding Left}" Width="30" Margin="2">
                <Image Width="16" Source="../Images/AlignLeft.png" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Center}" Width="30" Margin="2">
                <Image Width="16" Source="../Images/AlignCenter.png" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Right}" Width="30" Margin="2">
                <Image Width="16" Source="../Images/AlignRight.png" />
            </ToggleButton>

            <ToggleButton IsChecked="{Binding Top}" Width="30" Margin="10 2 2 2">
                <Image Width="16" Source="../Images/AlignTop.png" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Middle}" Width="30" Margin="2">
                <Image Width="16" Source="../Images/AlignMiddle.png" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding Bottom}" Width="30" Margin="2">
                <Image Width="16" Source="../Images/AlignBottom.png" />
            </ToggleButton>
        </StackPanel>

        <TextBlock Grid.Row="4" VerticalAlignment="Center">Угол наклона</TextBlock>
        <extToolkit:DoubleUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Angle}" Margin="2" />
    </Grid>
</UserControl>
