<UserControl x:Class="CellReport.Studio.PropertiesWindows.FontControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:CellReport.Studio.PropertiesWindows"
            xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27" />
            <RowDefinition Height="27" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center">Шрифт</TextBlock>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="fontComboBox" Margin="2" SelectedValue="{Binding FontFamily}">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15" Height="20"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="1" VerticalAlignment="Center">Размер шрифта</TextBlock>
        <extToolkit:DoubleUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Size}" Margin="2" />
        
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="2" Orientation="Horizontal" >
            <ToggleButton Width="30" IsChecked="{Binding Bold}" Margin="2">
                <TextBlock Margin="2" FontWeight="Bold">Ж</TextBlock>
            </ToggleButton>
            <ToggleButton Width="30" IsChecked="{Binding Italic}" Margin="2">
                <TextBlock Margin="2" FontStyle="Italic">K</TextBlock>
            </ToggleButton>
            <ToggleButton Width="30" IsChecked="{Binding Underline}" Margin="2">
                <TextBlock Margin="2" TextDecorations="UnderLine" >Ч</TextBlock>
            </ToggleButton>
            <ToggleButton Width="30" IsChecked="{Binding Strikeout}" Margin="2">
                <TextBlock Margin="2" TextDecorations="Strikethrough">abc</TextBlock>
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
