<Window x:Class="CellReport.Studio.PropertiesWindows.ResourcesEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ресурсы" Height="420" Width="600" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" Name="resEditor">
	<Window.Resources>
		<Style TargetType="{x:Type Button}">
			<Setter Property="Width" Value="75" />
			<Setter Property="Margin" Value="2" />
		</Style>
		<Style TargetType="{x:Type ListBox}">
			<Setter Property="Margin" Value="5" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="ItemsPanel">
				<Setter.Value>
					<ItemsPanelTemplate>
						<WrapPanel Margin="5" />
					</ItemsPanelTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="ItemTemplate">
				<Setter.Value>
					<DataTemplate>
						<StackPanel Name="itemPanel">
							<Image Source="{Binding Image}" Width="128" Height="128" StretchDirection="DownOnly" Margin="5,5,5,0" />
							<TextBlock Name="lblName" Text="{Binding Name}" MaxWidth="128" HorizontalAlignment="Center" Margin="0,5" />
							<TextBox Name="txtName" Text="{Binding NewName}" MaxWidth="128" HorizontalAlignment="Center" Margin="0,2"
									 Visibility="Collapsed" LostFocus="txtName_LostFocus" />
						</StackPanel>
						<DataTemplate.Triggers>
							<DataTrigger Binding="{Binding IsEditMode}" Value="True">
								<Setter TargetName="lblName" Property="Visibility" Value="Collapsed" />
								<Setter TargetName="txtName" Property="Visibility" Value="Visible" />
								<Setter TargetName="itemPanel" Property="FocusManager.FocusedElement" Value="{Binding ElementName=txtName}" />
							</DataTrigger>
						</DataTemplate.Triggers>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style TargetType="{x:Type ListBoxItem}">
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_MouseLeftButtonDown" />
		</Style>
	</Window.Resources>
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ListBox Name="lstResources" ItemsSource="{Binding DesignResources, ElementName=resEditor}"></ListBox>

		<StackPanel Grid.Column="1" Margin="5">
			<Button Click="Add_Click">Добавить</Button>
			<Button Click="Rename_Click">Изменить</Button>
			<Button Click="Delete_Click">Удалить</Button>
		</StackPanel>

		<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
			<Button IsDefault="True" x:Name="_ok" Click="OkClick">OK</Button>
			<Button IsCancel="True" x:Name="_cancel">Отмена</Button>
		</StackPanel>
	</Grid>
</Window>
