<UserControl x:Class="CellReport.Studio.PropertiesWindows.BorderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
			 xmlns:local="clr-namespace:CellReport.Studio.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="91" d:DesignWidth="300" Name="borderControl">
	<UserControl.Resources>
		<local:WPFUnitsConverter x:Key="wpfUnitsConverter" />
	</UserControl.Resources>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27" />
            <RowDefinition Height="27" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"  VerticalAlignment="Center">Цвет</TextBlock>
        <extToolkit:ColorPicker Grid.Row="0" Grid.Column="1" SelectedColor="{Binding Color}" Margin="2" />
        <TextBlock Grid.Row="1"  VerticalAlignment="Center">Стиль</TextBlock>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="2" MaxDropDownHeight="162"
				  ItemsSource="{Binding Source={x:Static local:DesignLineStyle.Styles}}" SelectedItem="{Binding DesignStyle}">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<Canvas Width="100" Height="20">
						<Line Name="line" X1="0" Y1="10" X2="100" Y2="10"
							  StrokeThickness="{Binding WeightWPF}"
							  Stroke="{Binding DataContext.Color, ElementName=borderControl}" StrokeDashCap="Square"
							  StrokeDashArray="{Binding Style, Converter={StaticResource wpfUnitsConverter}, ConverterParameter=DashStyle}"
							  RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True"/>
					</Canvas>
				</DataTemplate>
			</ComboBox.ItemTemplate>
        </ComboBox>
		<TextBlock Grid.Row="2" VerticalAlignment="Center">Отступ</TextBlock>
		<extToolkit:DoubleUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Padding}" Margin="2" />
	</Grid>
</UserControl>
