<Window x:Class="CellReport.Studio.PropertiesWindows.TextContentProperty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текст" Height="300" Width="300" WindowStyle="ToolWindow">
    <StackPanel>
        <TextBlock>Текст</TextBlock>
        <TextBox Height="120" Text="{Binding Text}" />
        <TextBlock>Шаблон</TextBlock>
        <TextBox Height="110" Text="{Binding Template}" />
    </StackPanel>
</Window>
