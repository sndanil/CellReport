<Window x:Class="CellReport.Studio.PropertiesWindows.CellStyle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CellReport.Studio.PropertiesWindows"
		xmlns:vm="clr-namespace:CellReport.Studio.ViewModel"
        xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
        Title="Стиль ячейки" Height="260" Width="300" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
	<Window.Resources>
		<vm:WPFUnitsConverter x:Key="wpfUnitsConverter" />
		<Style x:Key="lineStyle" TargetType="{x:Type Line}">
			<Setter Property="Stroke" Value="{Binding Color}" />
			<Setter Property="StrokeThickness" Value="{Binding DesignStyle.WeightWPF}" />
			<Setter Property="StrokeDashArray" Value="{Binding DesignStyle.Style, Converter={StaticResource wpfUnitsConverter}, ConverterParameter=DashStyle}" />
			<Setter Property="StrokeDashCap" Value="Square" />
			<Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
			<Setter Property="SnapsToDevicePixels" Value="True" />
		</Style>
	</Window.Resources>
	<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27" />
            <RowDefinition Height="27" />
            <RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2">Идентификатор</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ID}" Margin="2" />

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="2">Цвет фона</TextBlock>
        <extToolkit:ColorPicker Grid.Row="1" Grid.Column="1" SelectedColor="{Binding Color}" Margin="2" x:Name="color" />

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="75" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <extToolkit:DropDownButton Content="Верх" Grid.Row="0" Grid.Column="1" Height="35" Width="100" DataContext="{Binding Path=TopBorder}">               
                <extToolkit:DropDownButton.DropDownContent>
                    <local:BorderControl />
                </extToolkit:DropDownButton.DropDownContent>
            </extToolkit:DropDownButton>

            <extToolkit:DropDownButton Content="Лево" Grid.Row="1" Grid.Column="0" Height="35" Width="70" DataContext="{Binding LeftBorder}" >
                <extToolkit:DropDownButton.DropDownContent>
                    <local:BorderControl />
                </extToolkit:DropDownButton.DropDownContent>
            </extToolkit:DropDownButton>

            <extToolkit:DropDownButton Content="Низ" Grid.Row="2" Grid.Column="1" Height="35" Width="100" DataContext="{Binding BottomBorder}" >
                <extToolkit:DropDownButton.DropDownContent>
                    <local:BorderControl/>
                </extToolkit:DropDownButton.DropDownContent>
            </extToolkit:DropDownButton>

            <extToolkit:DropDownButton Content="Право" Grid.Row="1" Grid.Column="2" Height="35" Width="70" DataContext="{Binding RightBorder}" >
                <extToolkit:DropDownButton.DropDownContent>
                    <local:BorderControl/>
                </extToolkit:DropDownButton.DropDownContent>
            </extToolkit:DropDownButton>
            
            <Canvas Grid.Row="1" Grid.Column="1" Width="100" Height="35">
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="100" Height="35" Fill="{Binding Color}"></Rectangle>
				<Line X1="0" X2="100" Y1="0" Y2="0" Style="{StaticResource lineStyle}" DataContext="{Binding TopBorder}" />
				<Line X1="0" X2="100" Y1="35" Y2="35" Style="{StaticResource lineStyle}" DataContext="{Binding BottomBorder}" />
				<Line X1="0" X2="0" Y1="0" Y2="35" Style="{StaticResource lineStyle}" DataContext="{Binding LeftBorder}" />
				<Line X1="100" X2="100" Y1="0" Y2="35" Style="{StaticResource lineStyle}" DataContext="{Binding RightBorder}" />
            </Canvas>
        </Grid>

		<StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button IsDefault="True" Width="75" Margin="2" x:Name="_ok" Click="OkClick">OK</Button>
			<Button IsCancel="True" Width="75" Margin="2" x:Name="_cancel">Отмена</Button>
		</StackPanel>
	</Grid>
</Window>
