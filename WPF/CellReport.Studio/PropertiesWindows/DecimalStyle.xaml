<Window x:Class="CellReport.Studio.PropertiesWindows.DecimalStyle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CellReport.Studio.PropertiesWindows"
        xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        Title="Стиль числа" Height="340" Width="400">
    <StackPanel>
        <local:TextBasedControl Margin="3">
        </local:TextBasedControl>
        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="27" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2">Формат</TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Format}" Margin="2" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center">Цвет отрицательного</TextBlock>
            <extToolkit:ColorPicker Grid.Row="1" Grid.Column="1" SelectedColor="{Binding NegativeColor}" Margin="2" x:Name="color" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsDefault="True" Width="75" Margin="2" x:Name="_ok" Click="OkClick">OK</Button>
            <Button IsCancel="True" Width="75" Margin="2" x:Name="_cancel">Отмена</Button>
        </StackPanel>
    </StackPanel>
</Window>
