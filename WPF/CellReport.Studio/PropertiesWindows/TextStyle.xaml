<Window x:Class="CellReport.Studio.PropertiesWindows.TextStyle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CellReport.Studio.PropertiesWindows"
        xmlns:extToolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        Title="Стиль текста" Height="285" Width="400">
    <StackPanel>
        <local:TextBasedControl Margin="3">
        </local:TextBasedControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsDefault="True" Width="75" Margin="2" x:Name="_ok" Click="OkClick">OK</Button>
            <Button IsCancel="True" Width="75" Margin="2" x:Name="_cancel">Отмена</Button>
        </StackPanel>
    </StackPanel>
</Window>
