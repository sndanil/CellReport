<Window x:Class="CellReport.Studio.Params"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CellReport.Studio.ViewModel"
        WindowStyle="ToolWindow"
        Title="Параметры" Height="300" Width="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="2" />
            </Style.Setters>
        </Style>
        <Style TargetType="TextBox">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
            </Style.Setters>
        </Style>
        <Style TargetType="Button">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
                <Setter Property="Width" Value="75" />
                <Setter Property="Height" Value="23" />
            </Style.Setters>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
                <Setter Property="Height" Value="25" />
            </Style.Setters>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <ListBox x:Name="_params"></ListBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Click="AddButtonClick">Добавить</Button>
            <Button Click="DelButtonClick">Удалить</Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right">
            <Button IsCancel="True" >Закрыть</Button>
        </StackPanel>
        <Grid Grid.Column="1" DataContext="{Binding ElementName=_params, Path=SelectedItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
                <RowDefinition Height="33" />
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Column="0">Название</TextBlock>
            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" x:Name="_name"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="1">Значение</TextBlock>
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Value, Mode=TwoWay}"></TextBox>

            <TextBlock Grid.Column="0" Grid.Row="2">Цель</TextBlock>
            <ComboBox Grid.Column="1" Grid.Row="2" SelectedValue="{Binding Target, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Tag=""></ComboBoxItem>
                <ComboBoxItem Tag="Text">Текст</ComboBoxItem>
                <ComboBoxItem Tag="Value">Значение</ComboBoxItem>
                <ComboBoxItem Tag="Code">Штрихкод</ComboBoxItem>
                <ComboBoxItem Tag="Type">Тип штрихкода</ComboBoxItem>
                <ComboBoxItem Tag="Uri">Адрес</ComboBoxItem>
                <ComboBoxItem Tag="Style">Стиль</ComboBoxItem>
                <ComboBoxItem Tag="Style.Color">Цвет</ComboBoxItem>
                <ComboBoxItem Tag="Style.NegativeColor">Цвет отрицательного числа</ComboBoxItem>
                <ComboBoxItem Tag="Style.HAlignment">Выравнивание по горизонтали</ComboBoxItem>
                <ComboBoxItem Tag="Style.VAlignment">Выравнивание по вертикали</ComboBoxItem>
                <ComboBoxItem Tag="Style.Direction">Направление</ComboBoxItem>
                <ComboBoxItem Tag="Style.Angle">Угол наклона</ComboBoxItem>
                <ComboBoxItem Tag="Style.Font.Size">Размер шрифта</ComboBoxItem>
                <ComboBoxItem Tag="Style.Font.Family">Шрифт</ComboBoxItem>
                <ComboBoxItem Tag="Style.Font.Style">Стиль шрифта</ComboBoxItem>
            </ComboBox>
            <TextBlock Grid.Column="0" Grid.Row="3">Выражение</TextBlock>
            <ComboBox Grid.Column="1" Grid.Row="3" SelectedItem="{Binding Expression, Mode=TwoWay}" x:Name="_expressions" />
                
        </Grid>
    </Grid>
</Window>
