<Window x:Class="CellReport.Studio.Expressions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выражения" Height="500" Width="500" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
                <Setter Property="Width" Value="75" />
                <Setter Property="Height" Value="23" />
            </Style.Setters>
        </Style>
        <Style TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
            </Style.Setters>
        </Style>
        <Style TargetType="TextBox">
            <Style.Setters>
                <Setter Property="Margin" Value="3" />
            </Style.Setters>
        </Style>
    </Window.Resources>
    <Grid x:Name="_expressions">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Expressions}" x:Name="_exprList" />

        <Grid Grid.Column="1" Grid.Row="0" DataContext="{Binding ElementName=_exprList, Path=SelectedItem}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock>Идентификатор</TextBlock>
            <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding ID, Mode=TwoWay}"></TextBox>

            <TextBlock Grid.Row="1">Начальное значение</TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Start, Mode=TwoWay}"></TextBox>
            <TextBlock Grid.Row="2">Инкремент</TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Increment, Mode=TwoWay}"></TextBox>

            <TextBlock Grid.Row="3">Название параметра</TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ParamName, Mode=TwoWay}"></TextBox>
            <CheckBox Margin="3" Grid.Row="4" Grid.ColumnSpan="2" IsChecked="{Binding PerPage, Mode=TwoWay}">По странице</CheckBox>
        </Grid>
        
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Добавить" Click="AddButtonClick">
                <Button.ContextMenu>
                    <ContextMenu x:Name="_menu">
                        <MenuItem Header="Счетчик" Click="AddCount" />
                        <MenuItem Header="Текущее дата и время" Click="AddNow" />
                        <MenuItem Header="Название отчета" Click="AddDocName" />
                        <MenuItem Header="Количество страниц" Click="AddPagesCount" />
                        <MenuItem Header="Сумма" Click="AddSum" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Удалить" Click="DelButtonClick" />
        </StackPanel>
    </Grid>
</Window>
