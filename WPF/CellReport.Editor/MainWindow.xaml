<fluent:RibbonWindow x:Class="CellReport.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:Fluent;assembly=Fluent"
					        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
					        xmlns:local="clr-namespace:CellReport.Editor.ViewModel"
        Title="Редактор отчетов" 
        Width="525" 
        Height="350"
        WindowState="Maximized">
	<Window.Resources>
		<local:EditorModel x:Key="EditorModel"/>
		<local:WpfUnitsConverter x:Key="WpfUnitsConverter" />
		<local:BoolToVisibilityConverter x:Key="BoolToHiddenConverter" TrueValue="Visible" FalseValue="Collapsed" />
		<local:DecimalStyleConverter x:Key="DecimalStyleConverter" />
		<local:DateTimeStyleConverter x:Key="DateTimeStyleConverter" />
		<local:InvertBoolConverter x:Key="InvertBoolConverter" />

		<Style x:Key="cellLineStyle" TargetType="{x:Type Line}">
			<Setter Property="SnapsToDevicePixels" Value="True" />
			<Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
			<Setter Property="Stroke" Value="{Binding Color}" />
			<Setter Property="StrokeThickness" Value="{Binding Weight, Converter={StaticResource WpfUnitsConverter}}" />
			<Setter Property="StrokeDashArray" Value="{Binding Style, Converter={StaticResource WpfUnitsConverter}, ConverterParameter=DashStyle}" />
			<Setter Property="StrokeDashCap" Value="Square" />
		</Style>

		<DataTemplate x:Key="cellStyleTemplate">
			<Canvas Width="150" Height="30" Margin="3">
				<Rectangle Canvas.Left="0" Canvas.Top="0" Width="150" Height="25" Fill="{Binding Color}" />
				<TextBlock Canvas.Left="5" Canvas.Top="3" Text="{Binding ID}" TextTrimming="CharacterEllipsis" Width="140">
				</TextBlock>
				<Line X1="0" X2="150" Y1="0" Y2="0" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Top}" />
				<Line X1="0" X2="150" Y1="25" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Bottom}" />
				<Line X1="0" X2="0" Y1="0" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Left}" />
				<Line X1="150" X2="150" Y1="0" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Right}" />
			</Canvas>
		</DataTemplate>
		<DataTemplate x:Key="textStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<TextBlock 
									Text="{Binding ID}"
									TextTrimming="CharacterEllipsis" Width="140"
									Foreground="{Binding Color}" 
									VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
									HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
									FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
									FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
									FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
									FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
								/>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="decimalStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<Grid Width="145">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock 
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Positive}" 
            Foreground="{Binding Color}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="1"
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Negative}" 
            Foreground="{Binding NegativeColor}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="2" 
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Zero}" 
            Foreground="{Binding Color}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="2" Text="{Binding ID}"></TextBlock>
				</Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="dateTimeStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock HorizontalAlignment="Right" 
                               Text="{Binding Converter={StaticResource DateTimeStyleConverter}, ConverterParameter=Positive}" 
                               Foreground="{Binding Color}" 
                               FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
                               FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
                               />
					<TextBlock Grid.Row="1" Text="{Binding ID}"></TextBlock>
				</Grid>
			</Border>
		</DataTemplate>

	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<fluent:Ribbon Grid.Row="0">

			<fluent:Ribbon.QuickAccessItems>
				<fluent:QuickAccessMenuItem IsChecked="True" Target="{Binding ElementName=SaveButton}">
				</fluent:QuickAccessMenuItem>
			</fluent:Ribbon.QuickAccessItems>

			<fluent:Ribbon.Menu>
				<fluent:Backstage>
					<fluent:BackstageTabControl>
						<fluent:Button Header="Создать" Command="local:EditorCommands.Create" KeyTip="N" />
						<fluent:Button Header="Открыть" Command="local:EditorCommands.Open" KeyTip="O" />
						<fluent:Button Header="Импорт" Command="local:EditorCommands.Import" KeyTip="I" />
						<fluent:Button Header="Сохранить" x:Name="SaveButton" Command="local:EditorCommands.Save" KeyTip="S" />
						<fluent:Button Header="Сохранить как" Command="local:EditorCommands.SaveAs" KeyTip="A" />
						<fluent:SeparatorTabItem Header="" />
						<fluent:Button Header="Предварительный просмотр" Command="local:EditorCommands.PrintPreview" KeyTip="P" />
						<fluent:Button Header="Печать" Command="local:EditorCommands.Print" />
						<fluent:SeparatorTabItem Header="" />
						<fluent:Button Header="Выход"
					                   Icon="pack://application:,,,/Fluent.Ribbon.Showcase;component/Images/Exit.png"
					                   KeyTip="X"
					                   Command="local:EditorCommands.Exit" />
					</fluent:BackstageTabControl>
				</fluent:Backstage>
			</fluent:Ribbon.Menu>

			<fluent:RibbonTabItem Header="Главная">
				<fluent:RibbonGroupBox Header="Буфер обмена">
					<fluent:Button Header="Вырезать"
												Icon="Images\16\clipboard_cut.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.Cut"
					/>
					<fluent:Button Header="Копировать"
												Icon="Images\16\clipboard_copy.png" 
												Size="Middle"
												Command="local:EditorCommands.Copy"
					/>
					<fluent:Button Header="Вставить"
												Icon="Images\16\clipboard_paste.png" 
												KeyTip="F"
												Size="Middle"
												Command="local:EditorCommands.Paste"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Действия">
					<fluent:Button Header="Отменить"
												Icon="Images\16\undo.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.Undo"
					/>
					<fluent:Button Header="Вернуть"
												Icon="Images\16\redo.png" 
												Size="Middle"
												Command="local:EditorCommands.Redo"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Поиск">
					<fluent:Button Header="Найти"
																Icon="Images\16\find.png" 
																KeyTip="F"
																Size="Middle"
																Command="local:EditorCommands.Find"
									/>
					<fluent:Button Header="Найти и заменить"
												Icon="Images\16\replace-find.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.FindAndReplace"
					/>
					<fluent:Button Header="Найти строку в коде"
												Icon="Images\16\script-find.png" 
												Size="Middle"
												Command="local:EditorCommands.FindInCode"
					/>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
			<fluent:RibbonTabItem Header="Ячейки">
				<fluent:RibbonGroupBox Header="Строки и столбцы">
					<fluent:DropDownButton Header="Добавить строку"
																Icon="Images\32\row_add.png"
																LargeIcon="Images\32\row_add.png" >
						<MenuItem Header="Добавить строку" Command="local:EditorCommands.AddRows" />
						<MenuItem Header="Добавить строку после" Command="local:EditorCommands.AddRowsAfter" />
					</fluent:DropDownButton>
					<fluent:Button Header="Удалить строку"
												Icon="Images\32\row_delete.png"
												LargeIcon="Images\32\row_delete.png" Command="local:EditorCommands.DeleteRows" />
					<fluent:DropDownButton Header="Добавить столбец"
																Icon="Images\32\column_add.png"
																LargeIcon="Images\32\column_add.png">
						<MenuItem Header="Добавить столбец" Command="local:EditorCommands.AddColumns" />
						<MenuItem Header="Добавить столбец после" Command="local:EditorCommands.AddColumnsAfter" />
					</fluent:DropDownButton>
					<fluent:Button Header="Удалить столбец"
												Icon="Images\32\column_delete.png"
												LargeIcon="Images\32\column_delete.png" Command="local:EditorCommands.DeleteColumns" />
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Ячейки">
					<fluent:Button Header="Объединить ячейки"
												Icon="Images\16\merge.png" 
												KeyTip="M"
												Size="Middle"
												Command="local:EditorCommands.MergeCells"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Стиль">
					<fluent:InRibbonGallery ItemsSource="{Binding CellStyles}" ItemTemplate="{StaticResource cellStyleTemplate}" SelectedItem="{Binding CurrentCellStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="35">

					</fluent:InRibbonGallery>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
			<fluent:RibbonTabItem Header="Содержимое">
				<fluent:RibbonGroupBox Header="Контент">
					<fluent:DropDownButton Header="Добавить"
																Icon="Images\32\add_button.png"
																LargeIcon="Images\32\add_button.png">
						<MenuItem Header="Добавить текст" Command="local:EditorCommands.AddTextContent" 
											IsEnabled="{Binding IsTextContent, Converter={StaticResource InvertBoolConverter}}" />
						<MenuItem Header="Добавить число" Command="local:EditorCommands.AddDecimalContent"
													IsEnabled="{Binding IsDecimalContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Добавить дату" Command="local:EditorCommands.AddDateTimeContent"
													IsEnabled="{Binding IsDateTimeContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Добавить штрих-код" Command="local:EditorCommands.AddBarCodeContent"
													IsEnabled="{Binding IsBarCodeContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Добавить изображение" Command="local:EditorCommands.AddImageContent"
													IsEnabled="{Binding IsImageContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
					</fluent:DropDownButton>

					<fluent:Button Header="Удалить" Size="Large" LargeIcon="Images/32/delete.png" Command="local:EditorCommands.DeleteContent"></fluent:Button>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Стиль" Visibility="{Binding HasStyledContent, Converter={StaticResource BoolToHiddenConverter}}">
					<fluent:InRibbonGallery Visibility="{Binding IsTextContent, Converter={StaticResource BoolToHiddenConverter}}" 
									ItemsSource="{Binding TextStyles}" ItemTemplate="{StaticResource textStyleTemplate}" SelectedItem="{Binding CurrentTextStyle}"
									MaxItemsInRow="4"
									ItemWidth="160" 
									ItemHeight="35">

					</fluent:InRibbonGallery>
					<fluent:InRibbonGallery Visibility="{Binding IsDecimalContent, Converter={StaticResource BoolToHiddenConverter}}" 
																	ItemsSource="{Binding DecimalStyles}" ItemTemplate="{StaticResource decimalStyleTemplate}" SelectedItem="{Binding CurrentDecimalStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="57">

					</fluent:InRibbonGallery>
					<fluent:InRibbonGallery Visibility="{Binding IsDateTimeContent, Converter={StaticResource BoolToHiddenConverter}}" 
																	ItemsSource="{Binding DateTimeStyles}" ItemTemplate="{StaticResource dateTimeStyleTemplate}" SelectedItem="{Binding CurrentDateTimeStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="57">

					</fluent:InRibbonGallery>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
		</fluent:Ribbon>
		<TabControl Grid.Row="1" SelectionChanged="TabsSwitched" x:Name="MainTab">
			<TabItem Header="Дизайнер" x:Name="DesignerTab">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"></RowDefinition>
						<RowDefinition Height="*"></RowDefinition>
					</Grid.RowDefinitions>
					<Grid Grid.Row="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"></ColumnDefinition>
							<ColumnDefinition Width="*"></ColumnDefinition>
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Margin="3">Текст</TextBlock>
						<TextBox Grid.Column="1" Margin="3" MaxHeight="30" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTextContent}" TextWrapping="Wrap" AcceptsReturn="True"></TextBox>
					</Grid>
					<Grid Grid.Row="1" x:Name="ReportContainer">
					</Grid>
				</Grid>
			</TabItem>
			<TabItem Header="Код" x:Name="CodeTab">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition></RowDefinition>
						<RowDefinition Height="5"></RowDefinition>
						<RowDefinition Height="150"></RowDefinition>
					</Grid.RowDefinitions>
					<avalonEdit:TextEditor FontFamily="Consolas" SyntaxHighlighting="XML" x:Name="Editor">

					</avalonEdit:TextEditor>
					<GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch"></GridSplitter>
					<ListView Grid.Row="2" Name="SchemaErrors">
						<ListView.View>
							<GridView>
								<GridView.Columns>
									<!--<GridViewColumn Header="Строка" DisplayMemberBinding="{Binding Path=LineNumber}"></GridViewColumn>-->
									<!--<GridViewColumn Header="Строка" DisplayMemberBinding="{Binding Path=UnitCost, StringFormat={}{0:C}}"></GridViewColumn>-->
									<GridViewColumn Header="Ошибка" DisplayMemberBinding="{Binding Path=Message}"></GridViewColumn>
								</GridView.Columns>
							</GridView>
						</ListView.View>
					</ListView>
				</Grid>
			</TabItem>
		</TabControl>
		<fluent:StatusBar Grid.Row="2">
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="Размер  " />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding CurrentCellWidth, StringFormat={}{0}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" х " />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding CurrentCellHeight, StringFormat={}{0}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" мм " />
			<fluent:StatusBarItem Title="Масштаб" HorizontalAlignment="Right">
				<Slider Minimum="0"
				        Maximum="200"
				        IsDirectionReversed="False"
				        Style="{DynamicResource ZoomSliderStyle}"
				        Value="{Binding Scale}"
				        IsSnapToTickEnabled="True"
				        TickFrequency="0.1"
				        SmallChange="25"
				        LargeChange="25"								
				        />
			</fluent:StatusBarItem>
			<fluent:StatusBarItem HorizontalAlignment="Right" Value="{Binding Scale, StringFormat={}{0} %}" />
		</fluent:StatusBar>
	</Grid>
</fluent:RibbonWindow>
