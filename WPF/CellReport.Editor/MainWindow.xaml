<fluent:RibbonWindow x:Class="CellReport.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:Fluent;assembly=Fluent"
					        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
					        xmlns:local="clr-namespace:CellReport.Editor.ViewModel"
        Title="Редактор отчетов" 
        Width="525" 
        Height="350"
        WindowState="Maximized">
	<Window.Resources>
		<local:EditorModel x:Key="EditorModel"/>
		<local:WpfUnitsConverter x:Key="WpfUnitsConverter" />
		<local:BoolToVisibilityConverter x:Key="BoolToHiddenConverter" TrueValue="Visible" FalseValue="Collapsed" />
		<local:DecimalStyleConverter x:Key="DecimalStyleConverter" />
		<local:DateTimeStyleConverter x:Key="DateTimeStyleConverter" />
		<local:InvertBoolConverter x:Key="InvertBoolConverter" />
		<local:IsNotNullConverter x:Key="IsNotNullConverter" />

		<Style x:Key="cellLineStyle" TargetType="{x:Type Line}">
			<Setter Property="SnapsToDevicePixels" Value="True" />
			<Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
			<Setter Property="Stroke" Value="{Binding Color}" />
			<Setter Property="StrokeThickness" Value="{Binding Weight, Converter={StaticResource WpfUnitsConverter}}" />
			<Setter Property="StrokeDashArray" Value="{Binding Style, Converter={StaticResource WpfUnitsConverter}, ConverterParameter=DashStyle}" />
			<Setter Property="StrokeDashCap" Value="Square" />
		</Style>

		<DataTemplate x:Key="cellStyleTemplate">
			<Canvas Width="150" Height="30" Margin="3">
				<Rectangle Canvas.Left="0" Canvas.Top="0" Width="150" Height="25" Fill="{Binding Color}" />
				<TextBlock Canvas.Left="5" Canvas.Top="3" Text="{Binding ID}" TextTrimming="CharacterEllipsis" Width="140">
				</TextBlock>
				<Line X1="0" X2="150" Y1="0" Y2="0" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Top}" />
				<Line X1="0" X2="150" Y1="25" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Bottom}" />
				<Line X1="0" X2="0" Y1="0" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Left}" />
				<Line X1="150" X2="150" Y1="0" Y2="25" Style="{StaticResource cellLineStyle}" DataContext="{Binding Borders.Right}" />
			</Canvas>
		</DataTemplate>
		<DataTemplate x:Key="textStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<TextBlock 
									Text="{Binding ID}"
									TextTrimming="CharacterEllipsis" Width="140"
									Foreground="{Binding Color}" 
									VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
									HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
									FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
									FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
									FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
									FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
								/>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="decimalStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<Grid Width="145">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock 
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Positive}" 
            Foreground="{Binding Color}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="1"
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Negative}" 
            Foreground="{Binding NegativeColor}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="2" 
            Text="{Binding Converter={StaticResource DecimalStyleConverter}, ConverterParameter=Zero}" 
            Foreground="{Binding Color}" 
            VerticalAlignment="{Binding Path=VAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=VAlign}"
            HorizontalAlignment="{Binding Path=HAlignment, Converter={StaticResource WpfUnitsConverter},ConverterParameter=HAlign}"
            FontStyle="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontStyle}"
            FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
            FontWeight="{Binding Path=Font.Style, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontWeight}" 
            FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
            />
					<TextBlock Grid.Row="2" Text="{Binding ID}"></TextBlock>
				</Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="dateTimeStyleTemplate">
			<Border BorderBrush="Gray" BorderThickness="1" Padding="2" Margin="2">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock HorizontalAlignment="Right" 
                               Text="{Binding Converter={StaticResource DateTimeStyleConverter}, ConverterParameter=Positive}" 
                               Foreground="{Binding Color}" 
                               FontFamily="{Binding Path=Font.Family, Converter={StaticResource WpfUnitsConverter},ConverterParameter=FontFamily}" 
                               FontSize="{Binding Path=Font.Size, Converter={StaticResource WpfUnitsConverter},ConverterParameter=PointToWPF}" 
                               />
					<TextBlock Grid.Row="1" Text="{Binding ID}"></TextBlock>
				</Grid>
			</Border>
		</DataTemplate>

	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<fluent:Ribbon Grid.Row="0">

			<fluent:Ribbon.QuickAccessItems>
				<fluent:QuickAccessMenuItem IsChecked="True" Target="{Binding ElementName=SaveButton}">
				</fluent:QuickAccessMenuItem>
			</fluent:Ribbon.QuickAccessItems>

			<fluent:Ribbon.Menu>
				<fluent:Backstage>
					<fluent:BackstageTabControl>
						<fluent:Button Header="Создать" Command="local:EditorCommands.Create" KeyTip="N" />
						<fluent:Button Header="Открыть" Command="local:EditorCommands.Open" KeyTip="O" />
						<fluent:Button Header="Импорт" Command="local:EditorCommands.Import" KeyTip="I" />
						<fluent:Button Header="Сохранить" x:Name="SaveButton" Command="local:EditorCommands.Save" KeyTip="S" />
						<fluent:Button Header="Сохранить как" Command="local:EditorCommands.SaveAs" KeyTip="A" />
						<fluent:SeparatorTabItem Header="" />
						<fluent:Button Header="Предварительный просмотр" Command="local:EditorCommands.PrintPreview" KeyTip="P" />
						<fluent:Button Header="Печать" Command="local:EditorCommands.Print" />
						<fluent:SeparatorTabItem Header="" />
						<fluent:Button Header="Выход"
					                   Icon="pack://application:,,,/Fluent.Ribbon.Showcase;component/Images/Exit.png"
					                   KeyTip="X"
					                   Command="local:EditorCommands.Exit" />
					</fluent:BackstageTabControl>
				</fluent:Backstage>
			</fluent:Ribbon.Menu>

			<fluent:RibbonTabItem Header="Главная">
				<fluent:RibbonGroupBox Header="Буфер обмена">
					<fluent:Button Header="Вырезать"
												Icon="Images\16\clipboard_cut.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.Cut"
					/>
					<fluent:Button Header="Копировать"
												Icon="Images\16\clipboard_copy.png" 
												Size="Middle"
												Command="local:EditorCommands.Copy"
					/>
					<fluent:Button Header="Вставить"
												Icon="Images\16\clipboard_paste.png" 
												KeyTip="F"
												Size="Middle"
												Command="local:EditorCommands.Paste"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Действия">
					<fluent:Button Header="Отменить"
												Icon="Images\16\undo.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.Undo"
					/>
					<fluent:Button Header="Вернуть"
												Icon="Images\16\redo.png" 
												Size="Middle"
												Command="local:EditorCommands.Redo"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Поиск">
					<fluent:Button Header="Найти"
																Icon="Images\16\find.png" 
																KeyTip="F"
																Size="Middle"
																Command="local:EditorCommands.Find"
									/>
					<fluent:Button Header="Найти и заменить"
												Icon="Images\16\replace-find.png" 
												KeyTip="H"
												Size="Middle"
												Command="local:EditorCommands.FindAndReplace"
					/>
					<fluent:Button Header="Найти строку в коде"
												Icon="Images\16\script-find.png" 
												Size="Middle"
												Command="local:EditorCommands.FindInCode"
					/>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
			<fluent:RibbonTabItem Header="Ячейки">
				<fluent:RibbonGroupBox Header="Строки и столбцы">
					<fluent:DropDownButton Header="Добавить строку"
																Icon="Images\32\row_add.png"
																LargeIcon="Images\32\row_add.png" >
						<MenuItem Header="Добавить строку" Command="local:EditorCommands.AddRows" />
						<MenuItem Header="Добавить строку после" Command="local:EditorCommands.AddRowsAfter" />
					</fluent:DropDownButton>
					<fluent:Button Header="Удалить строку"
												Icon="Images\32\row_delete.png"
												LargeIcon="Images\32\row_delete.png" Command="local:EditorCommands.DeleteRows" />
					<fluent:DropDownButton Header="Добавить столбец"
																Icon="Images\32\column_add.png"
																LargeIcon="Images\32\column_add.png">
						<MenuItem Header="Добавить столбец" Command="local:EditorCommands.AddColumns" />
						<MenuItem Header="Добавить столбец после" Command="local:EditorCommands.AddColumnsAfter" />
					</fluent:DropDownButton>
					<fluent:Button Header="Удалить столбец"
												Icon="Images\32\column_delete.png"
												LargeIcon="Images\32\column_delete.png" Command="local:EditorCommands.DeleteColumns" />
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Ячейки">
					<fluent:Button Header="Объединить ячейки"
												Icon="Images\16\merge.png" 
												KeyTip="M"
												Size="Middle"
												Command="local:EditorCommands.MergeCells"
					/>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Стиль">
					<fluent:InRibbonGallery ItemsSource="{Binding CellStyles}" ItemTemplate="{StaticResource cellStyleTemplate}" SelectedItem="{Binding CurrentCellStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="35">

					</fluent:InRibbonGallery>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
			<fluent:RibbonTabItem Header="Содержимое">
				<fluent:RibbonGroupBox Header="Контент">
					<fluent:DropDownButton Header="Добавить"
																Icon="Images\32\add_button.png"
																LargeIcon="Images\32\add_button.png">
						<MenuItem Header="Текст" Command="local:EditorCommands.AddTextContent" 
											IsEnabled="{Binding IsTextContent, Converter={StaticResource InvertBoolConverter}}" />
						<MenuItem Header="Число" Command="local:EditorCommands.AddDecimalContent"
													IsEnabled="{Binding IsDecimalContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Дату и время" Command="local:EditorCommands.AddDateTimeContent"
													IsEnabled="{Binding IsDateTimeContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Штрих-код" Command="local:EditorCommands.AddBarCodeContent"
													IsEnabled="{Binding IsBarCodeContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Изображение" Command="local:EditorCommands.AddImageContent"
													IsEnabled="{Binding IsImageContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
						<MenuItem Header="Действие" Command="local:EditorCommands.AddActionContent"
											IsEnabled="{Binding IsActionContent, Converter={StaticResource InvertBoolConverter}}"></MenuItem>
					</fluent:DropDownButton>

					<fluent:Button Header="Удалить все" Size="Large" LargeIcon="Images/32/delete.png" Command="local:EditorCommands.DeleteContent"></fluent:Button>
				</fluent:RibbonGroupBox>
				<fluent:RibbonGroupBox Header="Стиль" Visibility="{Binding HasStyledContent, Converter={StaticResource BoolToHiddenConverter}}">
					<fluent:InRibbonGallery Visibility="{Binding IsTextContent, Converter={StaticResource BoolToHiddenConverter}}" 
									ItemsSource="{Binding TextStyles}" ItemTemplate="{StaticResource textStyleTemplate}" SelectedItem="{Binding CurrentTextStyle}"
									MaxItemsInRow="4"
									ItemWidth="160" 
									ItemHeight="35">

					</fluent:InRibbonGallery>
					<fluent:InRibbonGallery Visibility="{Binding IsDecimalContent, Converter={StaticResource BoolToHiddenConverter}}" 
																	ItemsSource="{Binding DecimalStyles}" ItemTemplate="{StaticResource decimalStyleTemplate}" SelectedItem="{Binding CurrentDecimalStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="57">

					</fluent:InRibbonGallery>
					<fluent:InRibbonGallery Visibility="{Binding IsDateTimeContent, Converter={StaticResource BoolToHiddenConverter}}" 
																	ItemsSource="{Binding DateTimeStyles}" ItemTemplate="{StaticResource dateTimeStyleTemplate}" SelectedItem="{Binding CurrentDateTimeStyle}"
																	MaxItemsInRow="4"
																	ItemWidth="160" 
																	ItemHeight="57">

					</fluent:InRibbonGallery>
				</fluent:RibbonGroupBox>
			</fluent:RibbonTabItem>
		</fluent:Ribbon>
		<TabControl Grid.Row="1" SelectionChanged="TabsSwitched" x:Name="MainTab">
			<TabItem Header="Дизайнер" x:Name="DesignerTab">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"></RowDefinition>
						<RowDefinition Height="*"></RowDefinition>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"></ColumnDefinition>
						<ColumnDefinition Width="*"></ColumnDefinition>
					</Grid.ColumnDefinitions>
					<Grid Grid.Row="0" Grid.ColumnSpan="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"></ColumnDefinition>
							<ColumnDefinition Width="*"></ColumnDefinition>
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Column="0" Margin="3">Текст</TextBlock>
						<TextBox Grid.Column="1" Margin="3" Height="35" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTextContent}" TextWrapping="Wrap" AcceptsReturn="True"></TextBox>
					</Grid>
					<TabControl Grid.Row="1" Grid.Column="0" Width="200">
						<TabItem Header="Параметры">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"></RowDefinition>
										<RowDefinition Height="Auto"></RowDefinition>
										<RowDefinition Height="Auto"></RowDefinition>
										<RowDefinition Height="*"></RowDefinition>
									</Grid.RowDefinitions>
									<Label>Список содержимого</Label>
									<ListBox Grid.Row="1" Height="100" Margin="2" ItemsSource="{Binding CurrentContents}" SelectedItem="{Binding CurrentContent}" IsEnabled="{Binding HasContent}"></ListBox>
									<Grid Grid.Row="2">
										<Grid.RowDefinitions>
											<RowDefinition></RowDefinition>
											<RowDefinition></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition></ColumnDefinition>
											<ColumnDefinition></ColumnDefinition>
										</Grid.ColumnDefinitions>
										<Label Grid.ColumnSpan="2">Список параметров</Label>
										<ListBox Grid.Row="1" Grid.Column="0" Height="100" Margin="2" Grid.ColumnSpan="2" 
														 ItemsSource="{Binding ContentParams}" 
														IsEnabled="{Binding HasContent}"
														 SelectedItem="{Binding CurrentParam}" DisplayMemberPath="Name"></ListBox>
										<Button Grid.Row="2" Grid.Column="0" Margin="2" Command="local:EditorCommands.AddParam" IsEnabled="{Binding CurrentContent, Converter={StaticResource IsNotNullConverter}}">Добавить</Button>
										<Button Grid.Row="2" Grid.Column="1" Margin="2" Command="local:EditorCommands.DeleteParam" IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}">Удалить</Button>
									</Grid>
									<Grid Grid.Row="3" Margin="0 0 2 0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"></ColumnDefinition>
											<ColumnDefinition Width="*"></ColumnDefinition>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
										</Grid.RowDefinitions>

										<Label Grid.Row="0" Grid.Column="0">Имя</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="0" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Name, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="1" Grid.Column="0">Значение</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="1" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Value, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="2" Grid.Column="0">Цель</Label>
										<ComboBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="2" Grid.Column="1" MaxHeight="22" SelectedValue="{Binding CurrentParam.Target, Mode=TwoWay}" SelectedValuePath="Tag">
											<ComboBoxItem Tag="">Не установлено</ComboBoxItem>
											<ComboBoxItem Tag="Text">Текст</ComboBoxItem>
											<ComboBoxItem Tag="Value">Значение</ComboBoxItem>
											<ComboBoxItem Tag="Code">Штрих-код</ComboBoxItem>
											<ComboBoxItem Tag="Type">Тип штрих-кода</ComboBoxItem>
											<ComboBoxItem Tag="Uri">Адрес изображения</ComboBoxItem>
											<ComboBoxItem Tag="Style">Стиль</ComboBoxItem>
											<ComboBoxItem Tag="Style.Color">Цвет</ComboBoxItem>
											<ComboBoxItem Tag="Style.NegativeColor">Цвет отрицательного числа</ComboBoxItem>
											<ComboBoxItem Tag="Style.HAlignment">Выравнивание по горизонтали</ComboBoxItem>
											<ComboBoxItem Tag="Style.VAlignment">Выравнивание по вертикали</ComboBoxItem>
											<ComboBoxItem Tag="Style.Direction">Направление</ComboBoxItem>
											<ComboBoxItem Tag="Style.Angle">Угол наклона</ComboBoxItem>
											<ComboBoxItem Tag="Style.Font.Size">Размер шрифта</ComboBoxItem>
											<ComboBoxItem Tag="Style.Font.Family">Шрифт</ComboBoxItem>
											<ComboBoxItem Tag="Style.Font.Style">Стиль шрифта</ComboBoxItem>
											<ComboBoxItem Tag="Style.Format">Форматирование</ComboBoxItem>
											<ComboBoxItem Tag="Style.Culture">Культура</ComboBoxItem>
										</ComboBox>

										<Label Grid.Row="3" Grid.Column="0">Выражение</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="3" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Expression}"></TextBox>

										<Label Grid.Row="4" Grid.Column="0">Формат</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="4" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Format}"></TextBox>

										<Label Grid.Row="5" Grid.Column="0">Культура</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="5" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Culture}"></TextBox>

										<Label Grid.Row="6" Grid.Column="0">Тип</Label>
										<ComboBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="6" Grid.Column="1" MaxHeight="22" SelectedValue="{Binding CurrentParam.Type, Mode=TwoWay}" SelectedValuePath="Tag">
											<ComboBoxItem Tag="">Не установлено</ComboBoxItem>
											<ComboBoxItem Tag="Decimal">Число</ComboBoxItem>
											<ComboBoxItem Tag="DateTime">Дата и время</ComboBoxItem>
										</ComboBox>

										<Label Grid.Row="7" Grid.Column="0">Присвоить</Label>
										<TextBox IsEnabled="{Binding CurrentParam, Converter={StaticResource IsNotNullConverter}}" Grid.Row="7" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentParam.Assign}"></TextBox>
									</Grid>
								</Grid>
							</ScrollViewer>
						</TabItem>
						<TabItem Header="Секции">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition></RowDefinition>
											<RowDefinition></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition></ColumnDefinition>
											<ColumnDefinition></ColumnDefinition>
										</Grid.ColumnDefinitions>
										<ListBox Grid.Row="1" Grid.Column="0" Height="200" Margin="2" Grid.ColumnSpan="2" ItemsSource="{Binding Sections}" SelectedItem="{Binding CurrentSection}" DisplayMemberPath="Name"></ListBox>
										<Button Grid.Row="2" Grid.Column="0" Margin="2" Command="local:EditorCommands.AddSection">Добавить</Button>
										<Button Grid.Row="2" Grid.Column="1" Margin="2" Command="local:EditorCommands.DeleteSection" IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}">Удалить</Button>
									</Grid>
									<Grid Margin="0 0 2 0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"></ColumnDefinition>
											<ColumnDefinition Width="*"></ColumnDefinition>
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
											<RowDefinition Height="30"></RowDefinition>
										</Grid.RowDefinitions>

										<Label Grid.Row="0" Grid.Column="0">Имя</Label>
										<TextBox IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}" Grid.Row="0" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentSection.Name, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="1" Grid.Column="0">Лево</Label>
										<TextBox IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}" Grid.Row="1" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentSection.Left, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="2" Grid.Column="0">Верх</Label>
										<TextBox IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}" Grid.Row="2" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentSection.Top, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="3" Grid.Column="0">Право</Label>
										<TextBox IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}" Grid.Row="3" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentSection.Right, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Label Grid.Row="4" Grid.Column="0">Низ</Label>
										<TextBox IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}" Grid.Row="4" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentSection.Bottom, UpdateSourceTrigger=PropertyChanged}"></TextBox>

										<Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="2 2 0 2" Command="local:EditorCommands.SetSectionBounds" IsEnabled="{Binding CurrentSection, Converter={StaticResource IsNotNullConverter}}">Установить</Button>
									</Grid>
								</StackPanel>
							</ScrollViewer>
						</TabItem>
						<TabItem Header="Ячейка">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<Grid Margin="2">
									<Grid.RowDefinitions>
										<RowDefinition Height="30"></RowDefinition>
										<RowDefinition Height="30"></RowDefinition>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"></ColumnDefinition>
										<ColumnDefinition Width="*"></ColumnDefinition>
									</Grid.ColumnDefinitions>

									<Label Grid.Row="0" Grid.Column="0">Ширина</Label>
									<TextBox Grid.Row="0" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentCellWidth, UpdateSourceTrigger=PropertyChanged}"></TextBox>

									<Label Grid.Row="1" Grid.Column="0">Высота</Label>
									<TextBox Grid.Row="1" Grid.Column="1" MaxHeight="20" Text="{Binding CurrentCellHeight, UpdateSourceTrigger=PropertyChanged}"></TextBox>
								</Grid>
							</ScrollViewer>
						</TabItem>
					</TabControl>
					<Grid Grid.Row="1" Grid.Column="1" Margin="2 0 0 0" x:Name="ReportContainer">
					</Grid>
				</Grid>
			</TabItem>
			<TabItem Header="Код" x:Name="CodeTab">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition></RowDefinition>
						<RowDefinition Height="5"></RowDefinition>
						<RowDefinition Height="150"></RowDefinition>
					</Grid.RowDefinitions>
					<avalonEdit:TextEditor FontFamily="Consolas" SyntaxHighlighting="XML" x:Name="Editor">

					</avalonEdit:TextEditor>
					<GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Center" HorizontalAlignment="Stretch"></GridSplitter>
					<ListView Grid.Row="2" Name="SchemaErrors">
						<ListView.View>
							<GridView>
								<GridView.Columns>
									<!--<GridViewColumn Header="Строка" DisplayMemberBinding="{Binding Path=LineNumber}"></GridViewColumn>-->
									<!--<GridViewColumn Header="Строка" DisplayMemberBinding="{Binding Path=UnitCost, StringFormat={}{0:C}}"></GridViewColumn>-->
									<GridViewColumn Header="Ошибка" DisplayMemberBinding="{Binding Path=Message}"></GridViewColumn>
								</GridView.Columns>
							</GridView>
						</ListView.View>
					</ListView>
				</Grid>
			</TabItem>
		</TabControl>
		<fluent:StatusBar Grid.Row="2">
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="Размер  " />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding CurrentCellWidth, StringFormat={}{0}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" х " />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding CurrentCellHeight, StringFormat={}{0}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" мм " />

			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" (" Visibility="{Binding HaveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding SelectionWidth, StringFormat={}{0}}"
					Visibility="{Binding HaveSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" х " Visibility="{Binding HaveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value="{Binding SelectionHeight, StringFormat={}{0}}" 
					Visibility="{Binding HaveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<fluent:StatusBarItem HorizontalAlignment="Left" Value=" мм) " Visibility="{Binding HaveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
			
			<fluent:StatusBarItem Title="Масштаб" HorizontalAlignment="Right">
				<Slider Minimum="0"
				        Maximum="200"
				        IsDirectionReversed="False"
				        Style="{DynamicResource ZoomSliderStyle}"
				        Value="{Binding Scale}"
				        IsSnapToTickEnabled="True"
				        TickFrequency="0.1"
				        SmallChange="25"
				        LargeChange="25"								
				        />
			</fluent:StatusBarItem>
			<fluent:StatusBarItem HorizontalAlignment="Right" Value="{Binding Scale, StringFormat={}{0} %}" />
		</fluent:StatusBar>
	</Grid>
</fluent:RibbonWindow>
