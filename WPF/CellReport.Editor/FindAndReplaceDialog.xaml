<Window x:Class="CellReport.Editor.FindAndReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CellReport.Editor"
        mc:Ignorable="d"
				Title="Найти и заменить" WindowStartupLocation="CenterOwner"
				Width="400" SizeToContent="Height" ResizeMode="NoResize" 
				WindowStyle="ToolWindow" ShowInTaskbar="False" Closed="Window_Closed">

	<Grid Margin="0,4">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<TabControl Name="MainTabControl" Height="Auto" Grid.ColumnSpan="2">
			<TabItem Header="Поиск">
				<StackPanel>
					<TextBlock Margin="3">Найти:</TextBlock>
					<TextBox Margin="3" Name="FindText" />
					<Button Margin="5" HorizontalAlignment="Right" Width="100" Height="30" Content="Найти далее" Click="FindNextClick" IsDefault="True" />
				</StackPanel>
			</TabItem>
			<TabItem Header="Замена">
				<StackPanel>
					<TextBlock Margin="3">Найти:</TextBlock>
					<TextBox Margin="3" Name="FindForReplaceText" />
					<TextBlock Margin="3" Text="Заменить на:" />
					<TextBox Margin="3" Name="ReplaceText" />
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
						<Button Margin="5" HorizontalAlignment="Right" Width="100" Height="30" Content="Найти далее" Click="FindNext2Click" IsDefault="True" />
						<Button Margin="5" HorizontalAlignment="Right" Width="100" Content="Заменить" Click="ReplaceClick" />
						<Button Margin="5" HorizontalAlignment="Right" Width="100" Content="Заменить все" Click="ReplaceAllClick" />
					</StackPanel>
				</StackPanel>
			</TabItem>
		</TabControl>

		<CheckBox Grid.Row="1" Grid.Column="0" Margin="10,2" Name="IsCaseSensitive" Content="Учитывать регистр" />
		<CheckBox Grid.Row="2" Grid.Column="0" Margin="10,2" Name="IsWholeWord" Content="Слово целиком" />
		<CheckBox Grid.Row="1" Grid.Column="1" Margin="10,2" Name="IsRegex" Content="Регулярное выражение" />
		<CheckBox Grid.Row="2" Grid.Column="1" Margin="10,2" Name="IsSearchUp" Content="Справа налево" />
		<CheckBox Grid.Row="3" Grid.Column="1" Margin="10,2" Name="IsWildcards" Content="Wildcards" Visibility="Collapsed" />
	</Grid>
</Window>
