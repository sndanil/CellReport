<Project>
  <PropertyGroup>
    <Authors>Daniil Safonov</Authors>
    <Company>Daniil Safonov</Company>
    <Copyright>Copyright © Daniil Safonov 2011-2026</Copyright>
    <RepositoryUrl>https://github.com/sndanil/CellReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- NuGet defaults (override in packable projects) -->
    <IsPackable>false</IsPackable>
    <Version Condition="'$(Version)' == ''">0.11.2605.0311</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sndanil/CellReport</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
